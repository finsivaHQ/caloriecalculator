---
import Layout from "./Layout.astro";
import Section from "../components/ui/Section.astro";
import FaqSection from "../components/FaqSection.astro";
import Button from "../components/ui/Button.astro";
import { ALL_CALCULATORS } from "../data/site";

import type { FaqItem } from "../lib/seo";
import { breadcrumbSchema, faqSchema, articleSchema } from "../lib/seo";

interface Props {
  title: string;
  h1: string;
  description: string;
  path: string;
  category?: string;
  categoryPath?: string;
  lead?: string;
  updated?: string;
  faqs?: FaqItem[];
  showCta?: boolean;
  lang?: string;
  hreflangs?: {href: string, hreflang: string}[];
}

const {
  title,
  h1,
  description,
  path,
  category,
  categoryPath,
  lead,
  updated,
  faqs = [],
  showCta = true,
  lang = 'en',
  hreflangs = [],
} = Astro.props;

const crumbs = [
  { name: "Home", path: "/" },
  ...(category && categoryPath ? [{ name: category, path: categoryPath }] : []),
  { name: h1, path },
];

const jsonLd = [
  breadcrumbSchema(crumbs),
  ...(category ? [articleSchema({ headline: h1, description, path, dateModified: updated, })] : []),
  ...(faqs.length ? [faqSchema(faqs)] : []),
];

const relatedTools = ALL_CALCULATORS.filter(c => c.lang === lang && c.href !== path).slice(0, 6);
const showRelated = relatedTools.length > 0;
---

<Layout title={title} description={description} canonical={path} ogType="article" jsonLd={jsonLd} lang={lang} hreflangs={hreflangs}>
  <nav aria-label="Breadcrumb" class="bg-canvas border-b border-hairline/50">
    <ol class="container-page flex flex-wrap items-center gap-2 py-4 text-[0.6875rem] font-medium uppercase tracking-widest text-mute">
      {
        crumbs.map((c, i) => (
          <li class="flex items-center gap-2">
            {i > 0 && <span aria-hidden="true" class="text-hairline-strong">/</span>}
            {i < crumbs.length - 1 ? (
              <a href={c.path} class="transition-colors hover:text-ink">{c.name}</a>
            ) : (
              <span class="text-ink" aria-current="page">{c.name}</span>
            )}
          </li>
        ))
      }
    </ol>
  </nav>

  <header class="bg-canvas border-b border-hairline">
    <div class="container-page max-w-[760px] py-12 sm:py-20 text-center">
      {category && <p class="text-xs font-bold uppercase tracking-widest text-success mb-4">{category}</p>}
      <h1 class="text-[2.5rem] sm:text-[3.5rem] font-bold text-ink leading-tight tracking-tight">{h1}</h1>
      {lead && <p class="mt-6 text-xl text-body leading-relaxed max-w-2xl mx-auto">{lead}</p>}

      <div class="mt-8 flex flex-wrap justify-center gap-4 text-xs font-medium uppercase tracking-widest text-mute">
        {updated && <span>Updated {updated}</span>}
      </div>
    </div>
  </header>

  <div class="bg-surface py-12 sm:py-20">
    <article class="prose-content mx-auto max-w-[760px] px-4 sm:px-6">
      <slot />
    </article>
  </div>

  {
    faqs.length > 0 && (
      <Section class="bg-canvas-soft border-t border-hairline py-16 sm:py-24">
        <div class="mx-auto max-w-3xl px-4 sm:px-6">
          <div class="mb-10 text-center">
            <h2 class="text-2xl sm:text-3xl font-bold text-ink tracking-tight">Frequently Asked Questions</h2>
          </div>
          <FaqSection items={faqs} />
        </div>
      </Section>
    )
  }

  {
    showCta && (
      <Section class="bg-brand py-20 text-center border-t border-hairline">
        <div class="mx-auto max-w-2xl px-4">
          <h2 class="text-3xl font-bold text-brand-fg mb-4 tracking-tight">{lang === 'es' ? 'Calcula tus números' : 'Calculate your numbers'}</h2>
          <p class="text-brand-fg/80 text-lg mb-8 max-w-lg mx-auto">{lang === 'es' ? 'Pon esto en práctica: obtén tus objetivos personalizados de calorías y macros gratis.' : 'Put this into practice - get your personalized calorie and macro targets free.'}</p>
          <Button href={lang === 'es' ? "/country/spain/calculadora-de-calorias/#calculator" : "/#calculator"} size="lg" variant="secondary" class="bg-surface text-brand hover:bg-canvas">
            {lang === 'es' ? 'Abrir la calculadora' : 'Open the calculator'}
          </Button>
        </div>
      </Section>
    )
  }
  {
    showCta && showRelated && (
      <Section class="bg-surface py-16 sm:py-24 border-t border-hairline">
        <div class="container-page max-w-5xl">
          <div class="text-center mb-12 border-b border-hairline pb-4">
            <h2 class="text-2xl sm:text-3xl font-bold text-ink tracking-tight">{lang === 'es' ? 'Explora Herramientas Populares' : 'Explore Popular Tools'}</h2>
            <p class="text-mute mt-2">{lang === 'es' ? 'Descubre más calculadoras gratuitas para optimizar tu viaje fitness.' : 'Discover more free calculators to optimize your fitness journey.'}</p>
          </div>
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
            {relatedTools.map(c => (
              <a href={c.href} class="group flex flex-col rounded-2xl border border-hairline bg-canvas p-6 shadow-sm transition-all hover:border-brand/30 hover:shadow-md">
                <h3 class="font-semibold text-lg text-ink group-hover:text-brand">{c.label}</h3>
                <p class="text-sm text-body leading-relaxed mt-2">{c.desc}</p>
              </a>
            ))}
          </div>
        </div>
      </Section>
    )
  }
</Layout>
