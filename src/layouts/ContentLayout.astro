---
import Layout from "./Layout.astro";
import Section from "../components/ui/Section.astro";
import FaqSection from "../components/FaqSection.astro";
import Button from "../components/ui/Button.astro";
import { ALL_CALCULATORS } from "../data/site";

import type { FaqItem } from "../lib/seo";
import { breadcrumbSchema, faqSchema, articleSchema } from "../lib/seo";

interface Props {
  title: string;
  h1: string;
  description: string;
  path: string;
  category?: string;
  categoryPath?: string;
  lead?: string;
  updated?: string;
  faqs?: FaqItem[];
  showCta?: boolean;
  lang?: string;
}

const {
  title,
  h1,
  description,
  path,
  category,
  categoryPath,
  lead,
  updated,
  faqs = [],
  showCta = true,
  lang = 'en',
} = Astro.props;

const crumbs = [
  { name: "Home", path: "/" },
  ...(category && categoryPath ? [{ name: category, path: categoryPath }] : []),
  { name: h1, path },
];

const jsonLd = [
  breadcrumbSchema(crumbs),
  ...(category ? [articleSchema({ headline: h1, description, path, dateModified: updated, })] : []),
  ...(faqs.length ? [faqSchema(faqs)] : []),
];

const relatedTools = ALL_CALCULATORS.filter(c => c.lang === lang && c.href !== path).slice(0, 6);
const showRelated = relatedTools.length > 0;
---

<Layout title={title} description={description} canonical={path} ogType="article" jsonLd={jsonLd} lang={lang}>
  <nav aria-label="Breadcrumb" class="border-b border-hairline bg-canvas-soft/40">
    <ol class="container-page flex flex-wrap items-center gap-2 py-3 text-xs text-mute">
      {
        crumbs.map((c, i) => (
          <li class="flex items-center gap-2">
            {i > 0 && <span aria-hidden="true">/</span>}
            {i < crumbs.length - 1 ? (
              <a href={c.path} class="transition-colors hover:text-ink">{c.name}</a>
            ) : (
              <span class="text-body" aria-current="page">{c.name}</span>
            )}
          </li>
        ))
      }
    </ol>
  </nav>

  <header class="relative overflow-hidden border-b border-hairline">

    <div class="container-page max-w-3xl py-12 sm:py-16">
      {category && <p class="text-sm font-medium text-brand">{category}</p>}
      <h1 class="mt-2 text-display-lg text-ink">{h1}</h1>
      {lead && <p class="mt-4 text-lg text-body">{lead}</p>}

      <div class="mt-4 flex flex-wrap gap-4 text-sm text-mute">
         </div>
    </div>
  </header>

  <div class="container-page py-12 sm:py-16">
    <article class="prose-content mx-auto max-w-3xl">
      <slot />



    </article>
  </div>

  {
    faqs.length > 0 && (
      <Section class="border-t border-hairline">
        <FaqSection items={faqs} />
      </Section>
    )
  }

  {
    showCta && (
      <Section class="border-t border-hairline">
        <div class="flex flex-col items-center justify-center rounded-xl border border-hairline bg-surface p-8 sm:p-12 shadow-sm">

          <div class="relative">
            <h2 class="text-display-sm text-ink">{lang === 'es' ? 'Calcula tus números' : 'Calculate your numbers'}</h2>
            <p class="mx-auto mt-2 max-w-md text-body">{lang === 'es' ? 'Pon esto en práctica: obtén tus objetivos personalizados de calorías y macros gratis.' : 'Put this into practice - get your personalized calorie and macro targets free.'}</p>
            <div class="mt-6"><Button href={lang === 'es' ? "/country/spain/calculadora-de-calorias/#calculator" : "/#calculator"} size="lg">{lang === 'es' ? 'Abrir la calculadora' : 'Open the calculator'}</Button></div>
          </div>
        </div>
      </Section>
    )
  }
  {
    showCta && showRelated && (
      <Section class="border-t border-hairline bg-canvas-soft">
        <div class="container-page">
          <div class="text-center mb-8">
            <h2 class="text-2xl font-bold text-ink">{lang === 'es' ? 'Explora Herramientas Populares' : 'Explore Popular Tools'}</h2>
            <p class="text-body mt-2">{lang === 'es' ? 'Descubre más calculadoras gratuitas para optimizar tu viaje fitness.' : 'Discover more free calculators to optimize your fitness journey.'}</p>
          </div>
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
            {relatedTools.map(c => (
              <a href={c.href} class="card p-5 transition-colors hover:border-hairline-strong hover:bg-canvas-soft block">
                <h3 class="font-bold text-ink text-base">{c.label}</h3>
                <p class="text-sm text-mute mt-1">{c.desc}</p>
              </a>
            ))}
          </div>
        </div>
      </Section>
    )
  }
</Layout>
