---
import Layout from "./Layout.astro";
import Section from "../components/ui/Section.astro";
import FaqSection from "../components/FaqSection.astro";

import { NAV, FOOTER, ALL_CALCULATORS } from "../data/site";
import type { FaqItem } from "../lib/seo";
import { breadcrumbSchema, calculatorSchema, faqSchema } from "../lib/seo";

interface Props {
  title: string;
  h1: string;
  description: string;
  intro: string;
  path: string;
  faqs?: FaqItem[];
  lang?: string;
}

const {
  title,
  h1,
  description,
  intro,
  path,
  faqs = [],
  lang = 'en',
} = Astro.props;

const crumbs = [
  { name: "Home", path: "/" },
  { name: h1, path },
];

const jsonLd = [
  breadcrumbSchema(crumbs),
  calculatorSchema(h1, description, path),
  ...(faqs.length ? [faqSchema(faqs)] : []),
];

const related = ALL_CALCULATORS.filter((c) => c.href !== path && c.lang === lang).slice(0, 6);
const showRelated = related.length > 0;
---

<Layout title={title} description={description} canonical={path} jsonLd={jsonLd} lang={lang}>
  <nav aria-label="Breadcrumb" class="border-b border-hairline bg-canvas-soft/40">
    <ol class="container-page flex flex-wrap items-center gap-2 py-3 text-xs text-mute">
      {
        crumbs.map((c, i) => (
          <li class="flex items-center gap-2">
            {i > 0 && <span aria-hidden="true">/</span>}
            {i < crumbs.length - 1 ? (
              <a href={c.path} class="transition-colors hover:text-ink">{c.name}</a>
            ) : (
              <span class="text-body" aria-current="page">{c.name}</span>
            )}
          </li>
        ))
      }
    </ol>
  </nav>

  <header class="relative overflow-hidden border-b border-hairline">

    <div class="container-page py-12 sm:py-16">
      <h1 class="max-w-3xl text-display-lg text-ink">{h1}</h1>
      <p class="mt-4 max-w-2xl text-lg text-body">{intro}</p>

      <div class="mt-4 flex flex-wrap gap-4 text-sm text-mute">
         </div>
    </div>
  </header>

   <Section class="!py-12 sm:!py-16">
     <slot />
   </Section>

   <div class="border-t border-hairline">
    <div class="container-page py-12 sm:py-16">
      <div class="prose-content mx-auto max-w-3xl">
        <slot name="content" />
      </div>
    </div>
  </div>

  {
    faqs.length > 0 && (
      <Section class="border-t border-hairline">
        <FaqSection items={faqs} />
      </Section>
    )
  }

  {showRelated && (
    <Section class="border-t border-hairline">
      <h2 class="text-display-sm text-ink">{lang === 'es' ? 'Calculadoras relacionadas' : 'Related calculators'}</h2>
      <div class="mt-6 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
        {
          related.map((c) => (
            <a
              href={c.href}
              class="card group flex items-center justify-between gap-3 p-4 transition-all hover:border-hairline-strong hover:bg-canvas-soft"
            >
              <div>
                <span class="block text-sm font-medium text-ink">{c.label}</span>
                {c.desc && <span class="block text-xs text-mute">{c.desc}</span>}
              </div>
              <svg class="h-4 w-4 shrink-0 text-mute transition-transform group-hover:translate-x-0.5 group-hover:text-ink" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
            </a>
          ))
        }
      </div>
    </Section>
  )}
</Layout>
