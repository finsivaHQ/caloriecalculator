---
import { SITE } from "../data/site";
const FOOTER_ES = [
  {
    title: "Calculadoras",
    links: [
      { label: "Calculadora de Calorías", href: "/country/spain/calculadora-de-calorias/" },
      { label: "Calculadora de Macros", href: "/country/spain/calculadora-de-macros/" },
      { label: "Guías en Español", href: "/country/spain/guias/" },
    ],
  },
  {
    title: "Empresa",
    links: [
      { label: "Sobre nosotros", href: "/about/" },
      { label: "Contacto", href: "/contact/" },
      { label: "Política editorial", href: "/editorial-policy/" },
    ],
  },
  {
    title: "Legal",
    links: [
      { label: "Aviso legal", href: "/disclaimer/" },
      { label: "Política de privacidad", href: "/privacy-policy/" },
      { label: "Términos y condiciones", href: "/terms/" },
      { label: "Mapa del sitio HTML", href: "/html-sitemap/" },
    ],
  },
];

const year = new Date().getFullYear();
---

<footer class="relative overflow-hidden border-t border-[#2e2d2a] bg-[#19191c] text-[#d6d0c7]">
  <div class="container-page py-16">
    <div class="grid gap-12 lg:grid-cols-12">
      <!-- Brand blurb -->
      <div class="lg:col-span-4 max-w-sm">
        <a href="/country/spain/calculadora-de-calorias/" class="flex items-center gap-3 font-semibold text-[#f7f1e8]">
          <span class="grid h-8 w-8 place-items-center rounded-full bg-brand text-white" aria-hidden="true">
            <svg viewBox="0 0 24 24" class="h-4.5 w-4.5" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M3 3v18h18" /><path d="M7 15l3-4 3 2 4-6" />
            </svg>
          </span>
          <span class="text-lg tracking-tight font-extrabold text-[#f7f1e8]">Calorie<span class="text-brand">Calculator</span>Free</span>
        </a>
        <p class="mt-5 text-sm leading-relaxed text-[#8e8b85]">
          Tu conjunto de herramientas definitivo para nutrición y fitness. Calculadoras gratuitas basadas en ciencia para ayudarte a alcanzar tus objetivos de peso con estimaciones claras.
        </p>
      </div>

      <!-- Links Wrapper -->
      <div class="lg:col-span-8 grid grid-cols-2 sm:grid-cols-3 gap-8 sm:gap-10">
        {
          FOOTER_ES.map((col) => (
            <div>
              <h3 class="text-xs font-bold tracking-widest text-[#f7f1e8] uppercase">
                {col.title}
              </h3>
              <ul class="mt-5 space-y-3">
                {col.links.map((link) => (
                  <li>
                    <a
                      href={link.href}
                      class="group inline-flex items-center text-sm font-medium text-[#8e8b85] transition-colors hover:text-[#f7f1e8]"
                    >
                      <span class="relative">
                        {link.label}
                        <span class="absolute -bottom-0.5 left-0 h-[1.5px] w-0 bg-brand transition-all duration-300 group-hover:w-full rounded-full"></span>
                      </span>
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </div>

    <div
      class="mt-16 flex flex-col items-start justify-between gap-6 border-t border-[#2e2d2a] pt-8 text-xs text-[#8e8b85] sm:flex-row sm:items-center"
    >
      <p class="font-medium">&copy; {year} {SITE.name}. Todos los derechos reservados.</p>
      <p class="max-w-md text-xs leading-relaxed text-[#8e8b85]/80">
        Solo para fines educativos. No es consejo médico — consulta a un profesional de la salud antes de tomar decisiones.
      </p>
    </div>
  </div>
</footer>
