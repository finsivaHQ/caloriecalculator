---
/**
 * ArticleImage ?" consistent, accessible, responsive image for article bodies.
 * Defaults to lazy loading and a constrained max width. Pass a meaningful
 * `alt` describing the image; decorative images should set alt="" explicitly.
 */
interface Props {
  src: string;
  alt: string;
  class?: string;
  width?: number;
  height?: number;
  priority?: boolean;
}

const { src, alt, class: className ="", width, height, priority = false } = Astro.props;

const finalSrc = src;
---

<figure class={`not-prose my-8 ${className}`}>
  <div class="rounded-2xl border border-hairline bg-surface p-2">
    <img
      src={finalSrc}
      alt={alt}
      loading={priority ?"eager" :"lazy"}
      decoding="async"
      fetchpriority={priority ?"high" :"auto"}
      {width}
      {height}
      class="mx-auto h-auto w-full max-w-2xl rounded-xl object-cover shadow-sm aspect-video"
    />
  </div>
</figure>
