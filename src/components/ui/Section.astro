---
/** Section — consistent vertical spacing + centered container. */
interface Props {
  class?: string;
  innerClass?: string;
  id?: string;
  as?: string;
}
const { class: className ="", innerClass ="", id, as ="section" } = Astro.props;
const Tag = as as any;
---

<Tag id={id} class={`py-16 sm:py-20 lg:py-28 ${className}`}>
  <div class={`container-page ${innerClass}`}>
    <slot />
  </div>
</Tag>
