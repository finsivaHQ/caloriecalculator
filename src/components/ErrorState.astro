---
import Button from"./ui/Button.astro";
import { NAV, FOOTER, ALL_CALCULATORS } from"../data/site";

interface Props {
  code: string;
  title: string;
  message: string;
}
const { code, title, message } = Astro.props;
const calculators = ALL_CALCULATORS.slice(0, 6);
---

<section class="container-page flex min-h-[60vh] flex-col items-center justify-center py-20 text-center">
  <p class="text-gradient text-display-xl font-semibold">{code}</p>
  <h1 class="mt-2 text-display-md text-ink">{title}</h1>
  <p class="mx-auto mt-3 max-w-md text-body">{message}</p>
  <div class="mt-7 flex flex-wrap justify-center gap-3">
    <Button href="/" size="lg">Back to calculator</Button>
    <Button href="/guides/how-many-calories-should-i-eat/" variant="secondary" size="lg">Read the guides</Button>
  </div>
  <div class="mt-10 grid w-full max-w-2xl grid-cols-2 gap-3 sm:grid-cols-3">
    {
      calculators.map((c) => (
        <a href={c.href} class="card p-3 text-sm font-medium text-ink transition-colors hover:bg-canvas-soft">
          {c.label}
        </a>
      ))
    }
  </div>
</section>
