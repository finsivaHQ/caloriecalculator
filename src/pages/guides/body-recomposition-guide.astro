    <h2 class="text-3xl md:text-4xl font-extrabold text-gray-900 mb-8 text-center relative z-10 tracking-tight">Boost Your Results: Suggested Content</h2>
    
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-12 relative z-10">
      <a href="/guides/protein-guide/" class="group flex flex-col p-8 bg-white/70 backdrop-blur-md rounded-2xl shadow-sm hover:shadow-sm transition-all duration-300 border border-transparent hover:border-brand/30 hover:-translate-y-1">
