  <table>
    <thead><tr><th scope="col">Profile (Age, Weight, Height)</th><th scope="col">Calculated BMR (kcal/day)</th><th scope="col">Physiological Notes</th></tr></thead>
    <tbody>
      <tr><td>Woman, 25, 60 kg (132 lbs), 165 cm (5'5")</td><td>~1,340 kcal</td><td>Baseline for a healthy, active young woman</td></tr>
