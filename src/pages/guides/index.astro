---
import Layout from "../../layouts/Layout.astro";
import Section from "../../components/ui/Section.astro";
import { breadcrumbSchema } from "../../lib/seo";

const posts = [
  {
    "title": "What is BMR? — Basal Metabolic Rate Explained",
    "description": "A clear, clinical explanation of Basal Metabolic Rate (BMR): how it is calculated with Mifflin-St Jeor and Harris-Benedict, and how to use it for your goals.",
    "href": "/guides/what-is-bmr/"
  },
  {
    "title": "Body Recomposition Guide: Lose Fat & Build Muscle",
    "description": "Learn the science of body recomposition. Discover how to lose fat and build lean muscle at the exact same time using the right calories and protein.",
    "href": "/guides/body-recomposition-guide/"
  },
  {
    "title": "Are Calorie Calculators Accurate? (The Truth About TDEE Math)",
    "description": "Discover how accurate online calorie calculators really are. Learn the margin of error, why the Mifflin-St Jeor equation is best, and how to adjust for your metabolism.",
    "href": "/guides/calorie-calculator-accuracy/"
  },
  {
    "title": "Calorie Surplus Guide — How to Build Muscle & Lean Bulk",
    "description": "How to gain lean weight and build muscle the healthy way: setting an optimal calorie surplus, optimizing macros, and avoiding unnecessary fat gain.",
    "href": "/guides/calorie-surplus-guide/"
  },
  {
    "title": "Healthy Weight Range: What It Means and How to Achieve It",
    "description": "Learn what a healthy weight range is, how to calculate your BMI, the importance of body fat percentage, and scientific steps to reach your goal.",
    "href": "/guides/healthy-weight-range/"
  },
  {
    "title": "How Many Calories in a Gram of Protein, Carbs, Fat & Alcohol?",
    "description": "Discover the exact caloric density of each macronutrient, Atwater general factors, and how calorie math powers nutrition labels.",
    "href": "/guides/how-many-calories-in-a-gram-guide/"
  },
  {
    "title": "Beginners Guide to Counting Macros | Ultimate Macro Diet Guide",
    "description": "Learn everything you need to know about counting macros. Our ultimate beginner guide breaks down protein, carbs, and fats to help you master the macro diet.",
    "href": "/guides/macro-guide/"
  },
  {
    "title": "Protein vs Carbs: Differences, Satiety & Fat Loss Explained",
    "description": "Discover the truth behind the 4-calorie paradox, thermic effect of food, satiety hormones, and whether protein or carbs is best for your fitness goals.",
    "href": "/guides/protein-vs-carbs/"
  },
  {
    "title": "Maintenance Calories: How to Stay at Your Ideal Weight",
    "description": "Learn what maintenance calories are, why they shift over time, and how to keep your weight stable without constant tracking.",
    "href": "/guides/maintenance-calories/"
  },
  {
    "title": "Starvation Mode vs. Metabolic Adaptation: The Science Explained",
    "description": "Learn the truth about starvation mode and metabolic adaptation. Discover how your body actually responds to a calorie deficit and how to overcome weight loss plateaus.",
    "href": "/guides/starvation-mode-metabolic-adaptation/"
  },
  {
    "title": "Thermic Effect of Food (TEF): How Many Calories Are Burned Digesting Food?",
    "description": "Learn about the thermic effect of food (TEF), diet-induced thermogenesis, and how many calories are required to digest protein, carbs, and fats to boost your metabolism naturally.",
    "href": "/guides/thermic-effect-of-food-tef/"
  },
  {
    "title": "What is NEAT Calories? Understanding Non-Exercise Activity Thermogenesis",
    "description": "Discover what NEAT calories are, how Non-Exercise Activity Thermogenesis impacts your metabolism and TDEE, and practical ways to increase NEAT for weight loss.",
    "href": "/guides/what-is-neat-calories/"
  },
  {
    "title": "Kcal vs Calories vs Kilojoules: Differences and Conversions",
    "description": "Understand the real difference between kcal vs calories, learn the exact kcal meaning, and find out how to convert calories to kilojoules easily.",
    "href": "/calorie-basics/kcal-vs-calories-vs-kilojoules/"
  },
  {
    "title": "What is a Calorie? The Ultimate Guide to Energy and Weight Management",
    "description": "What is a calorie? Learn about calorie definition, energy in food, how calories work in your body, and why they matter for weight management.",
    "href": "/calorie-basics/what-is-a-calorie/"
  }
];

const jsonLd = [breadcrumbSchema([{ name: "Home", path: "/" }, { name: "Blog", path: "/guides/" }])];
---

<Layout
  title="Nutrition & Weight Blog - Calorie Calculator Free"
  description="Free, science-based blog posts and guides on calories, macros, protein, weight loss, and weight gain to help you reach your goals."
  canonical="/guides/"
  jsonLd={jsonLd}
>
  <header class="relative overflow-hidden border-b border-hairline">
    <div class="bg-grid pointer-events-none absolute inset-0 -z-10 opacity-50" aria-hidden="true"></div>
    <div class="container-page py-12 sm:py-16">
      <span class="inline-block py-1 px-3 rounded-full bg-canvas-soft-2 border border-hairline text-xs font-semibold uppercase tracking-widest text-brand mb-3">
        Expert Guides
      </span>
      <h1 class="mt-2 text-display-lg text-ink">Nutrition &amp; Weight Blog</h1>
      <p class="mt-4 max-w-2xl text-lg text-body">Clear, science-based guides to help you understand calories, macros, and how to reach any weight goal.</p>
    </div>
  </header>
  <Section>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">
      {
        posts.map((post) => (
          <a href={post.href} class="group flex flex-col bg-surface border border-hairline rounded-3xl overflow-hidden hover:shadow-md hover:border-brand/50 transition-all duration-300">
            <div class="p-6 flex flex-col flex-1">
              <h2 class="text-xl font-bold text-ink mb-3 group-hover:text-brand transition-colors leading-tight">
                {post.title}
              </h2>
              <p class="text-sm text-body line-clamp-3 mb-4 flex-1">
                {post.description}
              </p>
              <div class="mt-auto flex items-center text-brand text-sm font-semibold">
                Read Article
                <svg class="ml-1 h-4 w-4 transition-transform group-hover:translate-x-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
              </div>
            </div>
          </a>
        ))
      }
    </div>
  </Section>
</Layout>
