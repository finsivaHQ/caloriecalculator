---
import Layout from "../../layouts/Layout.astro";
import Section from "../../components/ui/Section.astro";
import ArticleImage from "../../components/ui/ArticleImage.astro";
import { breadcrumbSchema } from "../../lib/seo";

const guides = [
  { label: "What is BMR?", href: "/guides/what-is-bmr/" },
  { label: "Mifflin-St Jeor Equation", href: "/guides/mifflin-st-jeor-equation/" },
  { label: "Mifflin-St Jeor Women", href: "/guides/mifflin-st-jeor-women/" },
  { label: "How Many Calories Should I Eat?", href: "/guides/how-many-calories-should-i-eat/" },
  { label: "Body Recomposition Guide", href: "/guides/body-recomposition-guide/" },
  { label: "Calorie Calculator Accuracy", href: "/guides/calorie-calculator-accuracy/" },
  { label: "Maintenance Calories", href: "/guides/maintenance-calories/" },
  { label: "What is TDEE?", href: "/guides/whats-my-tdee/" },
  { label: "BMR equations", href: "/guides/bmr-equations/" },
  { label: "Weight Loss Guide", href: "/guides/weight-loss-guide/" },
  { label: "Weight Gain Guide", href: "/guides/weight-gain-guide/" },
  { label: "Calorie Deficit Guide", href: "/guides/calorie-deficit-guide/" },
  { label: "Calorie Surplus Guide", href: "/guides/calorie-surplus-guide/" },
  { label: "Protein Guide", href: "/guides/protein-guide/" },
  { label: "Macro Guide", href: "/guides/macro-guide/" },
  { label: "Calories Burned in a Day", href: "/guides/calories-burned-in-a-day/" },
  { label: "Mifflin-St Jeor Stress Factors", href: "/guides/mifflin-st-jeor-stress-factors/" },
];

const jsonLd = [breadcrumbSchema([{ name: "Home", path: "/" }, { name: "Guides", path: "/guides/" }])];
---

<Layout
  title="Nutrition & Weight Guides — Calorie Calculator Free"
  description="Free, science-based guides on calories, macros, protein, weight loss, and weight gain to help you reach your goals."
  canonical="/guides/"
  jsonLd={jsonLd}
>
  <header class="relative overflow-hidden border-b border-hairline">
    <div class="bg-grid pointer-events-none absolute inset-0 -z-10 opacity-50" aria-hidden="true"></div>
    <div class="container-page py-12 sm:py-16">
      <p class="text-sm font-medium text-brand">Guides</p>
      <h1 class="mt-2 text-display-lg text-ink">Nutrition &amp; weight guides</h1>
      <p class="mt-4 max-w-2xl text-lg text-body">Clear, science-based guides to help you understand calories, macros, and how to reach any weight goal.</p>
    </div>
  </header>
  
  <Section>
    <ArticleImage src="/assets/images/articles/workout-routine.svg" alt="Illustration of nutrition and workout planning guides for achieving health goals." />

    <div class="prose-content mx-auto max-w-3xl">
      <p>These guides turn the numbers from our calculators into a plan you can follow. They cover how to set a calorie target, build a deficit or surplus, choose your macros, and apply the results to real meals and training. Start with <a href="/guides/how-many-calories-should-i-eat/">how many calories you should eat</a>, then move on to the topic that matches your goal.</p>
    </div>
    
    <div class="mt-8 grid gap-3 sm:grid-cols-2">
      {
        guides.map((g) => (
          <a href={g.href} class="card group flex items-center justify-between gap-3 p-5 transition-all hover:border-hairline-strong hover:bg-canvas-soft">
            <span class="text-base font-medium text-ink">{g.label}</span>
            <svg class="h-4 w-4 shrink-0 text-mute transition-transform group-hover:translate-x-0.5 group-hover:text-ink" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
          </a>
        ))
      }
    </div>
  </Section>
</Layout>
