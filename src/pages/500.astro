---
import Layout from"../layouts/Layout.astro";
import ErrorState from"../components/ErrorState.astro";
---

<Layout
  title="Something Went Wrong — Calorie Calculator Free"
  description="An unexpected error occurred. Please try again, or head back to our free calorie and nutrition calculators."
  noindex={true}
>
  <ErrorState
    code="500"
    title="Something went wrong"
    message="An unexpected error occurred on our end. Please refresh the page or try again in a moment — your data is safe and stays in your browser."
  />
</Layout>
