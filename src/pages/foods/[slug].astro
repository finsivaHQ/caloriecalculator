---
import Layout from '../../layouts/Layout.astro';
import { foods } from '../../data/foods';
import type { FoodData } from '../../data/foods';

export async function getStaticPaths() {
  return foods.map((food) => {
    // Find 3 related foods (either same category, or just next in list)
    let related = foods.filter(f => f.category === food.category && f.slug !== food.slug).slice(0, 3);
    if (related.length < 3) {
        const others = foods.filter(f => f.slug !== food.slug && !related.find(r => r.slug === f.slug)).slice(0, 3 - related.length);
        related = [...related, ...others];
    }
    
    return {
      params: { slug: food.slug },
      props: { food, related },
    };
  });
}

interface Props {
  food: FoodData;
  related: FoodData[];
}

const { food, related } = Astro.props;

// --- DYNAMIC MATH FOR TEXT GENERATION ---
const burnTimeWalking = Math.round(food.calories / 4); // 4 kcal/min walking
const burnTimeRunning = Math.round(food.calories / 11); // 11 kcal/min running
const burnTimeCycling = Math.round(food.calories / 8); // 8 kcal/min cycling

const isHighProtein = food.protein >= 15;
const isModerateProtein = food.protein >= 5 && food.protein < 15;
const isLowCarb = food.carbs <= 10;
const isHighCalorie = food.calories > 250;
const isLowCalorie = food.calories < 100;

// Dynamic FAQ Answers
const weightLossAnswer = isLowCalorie 
  ? `Yes, ${food.name} is generally considered excellent for weight loss. With only ${food.calories} calories per 100 grams, it is a low-calorie density food. This means you can eat a relatively large volume of it to feel full without consuming a massive amount of your daily caloric budget.` 
  : isHighCalorie 
    ? `While you can eat ${food.name} and still lose weight, you must be very careful with portion control. At ${food.calories} calories per 100g, it is highly calorie-dense. To lose weight, you must maintain a calorie deficit, so tracking your exact intake of ${food.name} is crucial.`
    : `${food.name} can easily fit into a weight loss diet when consumed in moderation. At ${food.calories} calories per 100g, it has a moderate caloric density. The key to weight loss is your overall daily calorie deficit, not just avoiding or eating one specific food.`;

const muscleAnswer = isHighProtein 
  ? `Absolutely. ${food.name} is an excellent choice for building muscle. Packing ${food.protein}g of protein per 100g, it provides a highly concentrated dose of the amino acids your body needs to repair and grow muscle tissue after resistance training.`
  : isModerateProtein 
    ? `${food.name} provides a moderate amount of protein (${food.protein}g per 100g). While it contributes to your daily protein goals, you will likely need to pair it with more protein-dense sources (like lean meats, tofu, or whey) to hit the high protein targets optimal for muscle hypertrophy.`
    : `No, ${food.name} is not a primary source of protein for muscle building. With only ${food.protein}g of protein per 100g, it does not provide enough amino acids on its own to stimulate significant muscle protein synthesis. You should pair it with high-protein foods.`;

const ketoAnswer = isLowCarb
  ? `Yes! ${food.name} is generally highly compatible with a strict Ketogenic diet. It contains only ${food.carbs}g of carbohydrates per 100g, making it very easy to fit into the standard limit of 20-50g of net carbs per day.`
  : `No, ${food.name} is not ideal for a strict Keto diet. It contains ${food.carbs}g of carbohydrates per 100g. Consuming even a moderate portion could easily spike your blood sugar and knock you out of a state of ketosis.`;


// Common serving estimation
function getCommonServing(f: FoodData) {
  const cat = f.category.toLowerCase();
  const name = f.name.toLowerCase();
  
  if (f.slug === 'eggs' || name.includes('egg')) return { label: '1 Large Whole Egg', grams: 50 };
  if (name.includes('banana')) return { label: '1 Medium Banana', grams: 118 };
  if (name.includes('apple')) return { label: '1 Medium Apple', grams: 182 };
  if (name.includes('orange')) return { label: '1 Medium Orange', grams: 131 };
  if (name.includes('avocado')) return { label: '1 Medium Avocado', grams: 150 };
  if (name.includes('potato') || name.includes('sweet potato')) return { label: '1 Medium Potato', grams: 150 };
  if (cat.includes('meat') || cat.includes('fish') || cat.includes('poultry')) return { label: '1 Cooked Portion / Fillet', grams: 150 };
  if (cat.includes('nut') || cat.includes('seed')) return { label: '1 Handful / Ounce', grams: 28 };
  if (name.includes('bread') || name.includes('toast')) return { label: '1 Standard Slice', grams: 35 };
  if (cat.includes('grain') || name.includes('rice') || name.includes('pasta') || name.includes('oats')) return { label: '1 Cooked Cup', grams: 160 };
  if (name.includes('milk') || name.includes('juice') || cat.includes('drink')) return { label: '1 Glass / Cup (240ml)', grams: 240 };
  if (cat.includes('dairy') && name.includes('cheese')) return { label: '1 Slice / 1 oz', grams: 28 };
  if (cat.includes('dairy') && name.includes('yogurt')) return { label: '1 Single-Serve Tub', grams: 170 };
  if (cat.includes('condiment') || cat.includes('oil') || cat.includes('butter') || cat.includes('spread')) return { label: '1 Tablespoon', grams: 15 };
  if (cat.includes('fruit')) return { label: '1 Typical Cup / Piece', grams: 140 };
  if (cat.includes('vegetable')) return { label: '1 Cup Chopped', grams: 100 };
  return { label: '1 Standard Serving', grams: 100 };
}

const commonServing = getCommonServing(food);
const servingCalories = Math.round((food.calories * commonServing.grams) / 100);
const servingProtein = +((food.protein * commonServing.grams) / 100).toFixed(1);
const servingCarbs = +((food.carbs * commonServing.grams) / 100).toFixed(1);
const servingFats = +((food.fats * commonServing.grams) / 100).toFixed(1);

const ozCalories = Math.round((food.calories * 28.35) / 100);
const ozProtein = +((food.protein * 28.35) / 100).toFixed(1);
const ozCarbs = +((food.carbs * 28.35) / 100).toFixed(1);
const ozFats = +((food.fats * 28.35) / 100).toFixed(1);

const servingAnswer = `One ${commonServing.label} (${commonServing.grams}g) of ${food.name} contains approximately ${servingCalories} calories, ${servingProtein}g of protein, ${servingCarbs}g of carbohydrates, and ${servingFats}g of dietary fats. By comparison, 100 grams provides ${food.calories} calories.`;

const nutritionSchema = {
  "@context": "https://schema.org",
  "@type": "NutritionInformation",
  "name": food.name,
  "servingSize": "100 grams",
  "calories": `${food.calories} calories`,
  "proteinContent": `${food.protein} grams`,
  "carbohydrateContent": `${food.carbs} grams`,
  "fatContent": `${food.fats} grams`
};

const title = `How many calories are in 100g of ${food.name}? | Nutrition Facts & Analysis`;
const description = `Comprehensive nutritional analysis of ${food.name}. Find out exactly how many calories, protein, carbs, and fats are in 100g, plus weight loss and keto compatibility.`;

const faqSchema = {"@context":"https://schema.org","@type":"FAQPage","mainEntity": [
    {"@type":"Question","name": `Is ${food.name} good for weight loss?`,"acceptedAnswer": {"@type":"Answer","text": weightLossAnswer
      }
    },
    {"@type":"Question","name": `Is ${food.name} good for building muscle?`,"acceptedAnswer": {"@type":"Answer","text": muscleAnswer
      }
    },
    {"@type":"Question","name": `Is ${food.name} keto-friendly?`,"acceptedAnswer": {"@type":"Answer","text": ketoAnswer
      }
    },
    {"@type":"Question","name": `How many calories are in 1 serving (${commonServing.label}) of ${food.name}?`,"acceptedAnswer": {"@type":"Answer","text": servingAnswer
      }
    }
  ]
};
---

<Layout title={title} description={description} path={`/foods/${food.slug}/`}>
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(nutritionSchema)} />

  <nav aria-label="Breadcrumb" class="border-b border-hairline bg-canvas-soft/40">
    <ol class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-wrap items-center gap-2 py-3 text-xs text-mute">
      <li class="flex items-center gap-2">
        <a href="/" class="transition-colors hover:text-ink">Home</a>
      </li>
      <li class="flex items-center gap-2">
        <span aria-hidden="true">/</span>
        <a href="/foods/" class="transition-colors hover:text-ink">Food Database</a>
      </li>
      <li class="flex items-center gap-2">
        <span aria-hidden="true">/</span>
        <span class="text-body" aria-current="page">{food.name}</span>
      </li>
    </ol>
  </nav>

  <div class="max-w-4xl mx-auto px-4 py-12 sm:px-6 lg:px-8">
    
    <!-- Hero / Headline -->
    <div class="text-center mb-12">
      <span class="inline-block py-1 px-3 rounded-full bg-brand/10 text-brand text-sm font-semibold tracking-wider mb-4 uppercase">{food.category}</span>
      <h1 class="text-4xl sm:text-5xl font-extrabold text-ink tracking-tight mb-4">
        How many calories are in 100g of <span class="text-brand">{food.name}</span>?
      </h1>
      <p class="text-xl text-body max-w-2xl mx-auto">
        {food.description}
      </p>
    </div>

    <!-- Data Visualization / Macro Ring -->
    <div class="bg-surface rounded-[2.5rem] p-8 shadow-xl border border-hairline mb-12 relative overflow-hidden">
      <div class="absolute top-0 left-0 w-full h-2 bg-gradient-to-r from-brand to-brand-light"></div>
      
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 items-center">
        <!-- Big Number -->
        <div class="text-center p-8 bg-canvas-soft rounded-3xl border border-hairline shadow-inner">
          <p class="text-mute font-medium mb-2 uppercase tracking-wide">Calories per 100g</p>
          <div class="text-7xl font-black text-ink mb-4">{food.calories} <span class="text-3xl text-mute font-bold">kcal</span></div>
          
          <div class="space-y-2 mt-6 text-sm font-medium text-body bg-surface p-4 rounded-xl border border-hairline shadow-sm text-left">
            <p class="text-center font-bold text-ink mb-3 border-b pb-2">How long to burn off {food.calories} calories?</p>
            <div class="flex justify-between items-center"><a href="/walking-calorie-calculator/" class="flex items-center gap-2 text-ink hover:text-brand hover:underline font-medium"><span>🚶</span> Walking (3mph)</a> <span>{burnTimeWalking} mins</span></div>
            <div class="flex justify-between items-center"><a href="/running-calorie-calculator/" class="flex items-center gap-2 text-ink hover:text-brand hover:underline font-medium"><span>🏃</span> Running (6mph)</a> <span>{burnTimeRunning} mins</span></div>
            <div class="flex justify-between items-center"><a href="/cycling-calories-calculator/" class="flex items-center gap-2 text-ink hover:text-brand hover:underline font-medium"><span>🚴</span> Cycling (12mph)</a> <span>{burnTimeCycling} mins</span></div>
          </div>
        </div>

        <!-- Macro Breakdown -->
        <div class="space-y-6">
          <h3 class="text-2xl font-bold text-ink mb-4">Macronutrient Breakdown</h3>
          
          <!-- Protein -->
          <div>
            <div class="flex justify-between text-sm font-bold mb-2">
              <span class="text-body">Protein (Muscle Building)</span>
              <span class="text-brand">{food.protein}g</span>
            </div>
            <div class="w-full bg-canvas-soft-2 rounded-full h-4 overflow-hidden">
              <div class="bg-brand h-4 rounded-full" style={`width: ${Math.min(100, (food.protein / 100) * 100)}%`}></div>
            </div>
          </div>
          
          <!-- Carbs -->
          <div>
            <div class="flex justify-between text-sm font-bold mb-2">
              <span class="text-body">Carbohydrates (Energy)</span>
              <span class="text-emerald-600">{food.carbs}g</span>
            </div>
            <div class="w-full bg-canvas-soft-2 rounded-full h-4 overflow-hidden">
              <div class="bg-emerald-500 h-4 rounded-full" style={`width: ${Math.min(100, (food.carbs / 100) * 100)}%`}></div>
            </div>
          </div>

          <!-- Fats -->
          <div>
            <div class="flex justify-between text-sm font-bold mb-2">
              <span class="text-body">Dietary Fats (Hormone Health)</span>
              <span class="text-amber-600">{food.fats}g</span>
            </div>
            <div class="w-full bg-canvas-soft-2 rounded-full h-4 overflow-hidden">
              <div class="bg-amber-500 h-4 rounded-full" style={`width: ${Math.min(100, (food.fats / 100) * 100)}%`}></div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Common Serving Sizes & Portion Calculator -->
    <div class="bg-surface rounded-3xl p-6 sm:p-8 border border-hairline shadow-sm mb-12">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-6 pb-4 border-b border-hairline">
        <div>
          <h2 class="text-2xl font-bold text-ink">Calories in Common Serving Sizes of {food.name}</h2>
          <p class="text-sm text-mute mt-1">Compare standard 100g measurements against everyday household portions.</p>
        </div>
      </div>

      <div class="overflow-x-auto not-prose mb-8">
        <table class="w-full text-left border-collapse text-sm">
          <thead>
            <tr class="border-b border-hairline text-mute uppercase text-xs">
              <th class="py-3 px-4 font-bold">Serving Size</th>
              <th class="py-3 px-4 font-bold">Weight (g)</th>
              <th class="py-3 px-4 font-bold">Calories</th>
              <th class="py-3 px-4 font-bold">Protein</th>
              <th class="py-3 px-4 font-bold">Carbs</th>
              <th class="py-3 px-4 font-bold">Fats</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-hairline">
            <tr class="hover:bg-canvas-soft/60 transition-colors">
              <td class="py-3 px-4 font-bold text-ink">{commonServing.label}</td>
              <td class="py-3 px-4 text-mute">{commonServing.grams}g</td>
              <td class="py-3 px-4 font-extrabold text-brand">{servingCalories} kcal</td>
              <td class="py-3 px-4 font-medium text-ink">{servingProtein}g</td>
              <td class="py-3 px-4 font-medium text-ink">{servingCarbs}g</td>
              <td class="py-3 px-4 font-medium text-ink">{servingFats}g</td>
            </tr>
            <tr class="bg-brand/5 hover:bg-brand/10 transition-colors">
              <td class="py-3 px-4 font-bold text-brand">100 Grams (Standard Reference)</td>
              <td class="py-3 px-4 text-mute">100g</td>
              <td class="py-3 px-4 font-extrabold text-brand">{food.calories} kcal</td>
              <td class="py-3 px-4 font-medium text-ink">{food.protein}g</td>
              <td class="py-3 px-4 font-medium text-ink">{food.carbs}g</td>
              <td class="py-3 px-4 font-medium text-ink">{food.fats}g</td>
            </tr>
            <tr class="hover:bg-canvas-soft/60 transition-colors">
              <td class="py-3 px-4 font-bold text-ink">1 Ounce (1 oz)</td>
              <td class="py-3 px-4 text-mute">28.35g</td>
              <td class="py-3 px-4 font-extrabold text-brand">{ozCalories} kcal</td>
              <td class="py-3 px-4 font-medium text-ink">{ozProtein}g</td>
              <td class="py-3 px-4 font-medium text-ink">{ozCarbs}g</td>
              <td class="py-3 px-4 font-medium text-ink">{ozFats}g</td>
            </tr>
            <tr class="hover:bg-canvas-soft/60 transition-colors">
              <td class="py-3 px-4 font-bold text-ink">200 Grams (Double Portion)</td>
              <td class="py-3 px-4 text-mute">200g</td>
              <td class="py-3 px-4 font-extrabold text-brand">{food.calories * 2} kcal</td>
              <td class="py-3 px-4 font-medium text-ink">{(food.protein * 2).toFixed(1)}g</td>
              <td class="py-3 px-4 font-medium text-ink">{(food.carbs * 2).toFixed(1)}g</td>
              <td class="py-3 px-4 font-medium text-ink">{(food.fats * 2).toFixed(1)}g</td>
            </tr>
          </tbody>
        </table>
      </div>

      <!-- Quick Interactive Gram Calculator -->
      <div class="bg-canvas-soft p-5 rounded-2xl border border-hairline">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-4">
          <div>
            <label for="portion-input" class="block font-bold text-ink text-sm">Custom Portion Calculator</label>
            <p class="text-xs text-mute mt-0.5">Enter exact weight in grams to calculate custom nutrition:</p>
          </div>
          <div class="flex items-center gap-2">
            <input type="number" id="portion-input" value={commonServing.grams} min="1" max="2000" class="w-24 px-3 py-2 text-sm font-bold text-ink bg-surface border border-hairline rounded-xl text-center shadow-inner" />
            <span class="text-xs font-semibold text-mute">grams</span>
          </div>
        </div>

        <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 text-center">
          <div class="p-3 bg-surface rounded-xl border border-hairline shadow-sm">
            <span class="text-xs text-mute block font-medium">Calories</span>
            <span id="custom-cals" class="text-lg font-black text-brand">{servingCalories}</span> <span class="text-xs text-mute font-bold">kcal</span>
          </div>
          <div class="p-3 bg-surface rounded-xl border border-hairline shadow-sm">
            <span class="text-xs text-mute block font-medium">Protein</span>
            <span id="custom-protein" class="text-lg font-black text-ink">{servingProtein}</span> <span class="text-xs text-mute font-bold">g</span>
          </div>
          <div class="p-3 bg-surface rounded-xl border border-hairline shadow-sm">
            <span class="text-xs text-mute block font-medium">Carbs</span>
            <span id="custom-carbs" class="text-lg font-black text-emerald-600">{servingCarbs}</span> <span class="text-xs text-mute font-bold">g</span>
          </div>
          <div class="p-3 bg-surface rounded-xl border border-hairline shadow-sm">
            <span class="text-xs text-mute block font-medium">Fats</span>
            <span id="custom-fats" class="text-lg font-black text-amber-600">{servingFats}</span> <span class="text-xs text-mute font-bold">g</span>
          </div>
        </div>
      </div>
    </div>

    <script define:vars={{ baseCalories: food.calories, baseProtein: food.protein, baseCarbs: food.carbs, baseFats: food.fats }}>
      const input = document.getElementById('portion-input');
      const calsEl = document.getElementById('custom-cals');
      const protEl = document.getElementById('custom-protein');
      const carbsEl = document.getElementById('custom-carbs');
      const fatsEl = document.getElementById('custom-fats');

      if (input && calsEl && protEl && carbsEl && fatsEl) {
        input.addEventListener('input', () => {
          const grams = parseFloat(input.value) || 0;
          calsEl.textContent = Math.round((baseCalories * grams) / 100);
          protEl.textContent = ((baseProtein * grams) / 100).toFixed(1);
          carbsEl.textContent = ((baseCarbs * grams) / 100).toFixed(1);
          fatsEl.textContent = ((baseFats * grams) / 100).toFixed(1);
        });
      }
    </script>

    
    <!-- Dynamic In-Depth Analysis (Information Gain) -->
    <div class="bg-surface rounded-3xl p-8 border border-hairline shadow-sm mb-12 prose prose-slate dark:prose-invert max-w-none prose-h2:text-2xl prose-h2:mb-4 prose-p:text-body leading-relaxed">
      <h2>Nutritional Analysis of {food.name}</h2>
      <p>
        When analyzing the macro profile of <strong>{food.name}</strong>, it's important to look beyond just the {food.calories} calorie count. 
        In every 100-gram serving, you are getting {food.protein}g of protein, {food.carbs}g of carbohydrates, and {food.fats}g of fats. 
        Depending on your specific metabolic goals—whether you are cutting fat, bulking up to gain muscle mass, or trying to maintain your current physique—this macro ratio will dictate how you should incorporate {food.name} into your daily diet plan.
      </p>

      <h2>Frequently Asked Questions</h2>
      
      <div class="space-y-6 mt-6">
        <div>
          <h3 class="text-lg font-bold text-ink mb-2">Is {food.name} good for weight loss?</h3>
          <p>{weightLossAnswer}</p>
        </div>
        
        <div>
          <h3 class="text-lg font-bold text-ink mb-2">Is {food.name} good for building muscle?</h3>
          <p>{muscleAnswer}</p>
        </div>

        <div>
          <h3 class="text-lg font-bold text-ink mb-2">Is {food.name} Keto-friendly?</h3>
          <p>{ketoAnswer}</p>
        </div>

        <div>
          <h3 class="text-lg font-bold text-ink mb-2">How many calories are in 1 serving ({commonServing.label}) of {food.name}?</h3>
          <p>{servingAnswer}</p>
        </div>
      </div>
    </div>

    <!-- The Spiderweb (Internal Linking) -->
    <div class="mt-16 bg-canvas-soft p-8 rounded-3xl border border-hairline">
      <h3 class="text-2xl font-bold text-ink mb-6 border-b border-hairline pb-4">Explore Similar Foods</h3>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-6">
        {related.map((item) => (
          <a href={`/foods/${item.slug}/`} class="block group">
            <div class="bg-surface p-6 rounded-2xl border border-hairline shadow-sm hover:shadow-md transition-all group-hover:-translate-y-1 hover:border-brand/30">
              <span class="text-xs font-bold text-mute uppercase tracking-wider block mb-2">{item.category}</span>
              <h4 class="text-lg font-bold text-ink mb-1 group-hover:text-brand transition-colors line-clamp-1">{item.name}</h4>
              <p class="text-mute font-medium">{item.calories} kcal <span class="text-xs text-mute">/ 100g</span></p>
            </div>
          </a>
        ))}
      </div>
      
      <div class="mt-10 flex flex-col sm:flex-row justify-center items-center gap-4">
        {isHighProtein ? (
          <>
            <a href="/protein-calculator/" class="inline-flex items-center gap-2 bg-brand text-white font-bold py-3.5 px-7 rounded-xl hover:bg-brand-hover transition-all hover:-translate-y-0.5 shadow-sm">
              Calculate Daily Protein Target
            </a>
            <a href="/protein-to-calories-calculator/" class="inline-flex items-center gap-2 bg-surface text-ink font-bold py-3.5 px-7 rounded-xl border border-hairline hover:border-brand/30 hover:text-brand transition-all hover:-translate-y-0.5 shadow-sm">
              Protein to Calories Converter
            </a>
          </>
        ) : (
          <>
            <a href="/calorie-deficit-calculator/" class="inline-flex items-center gap-2 bg-brand text-white font-bold py-3.5 px-7 rounded-xl hover:bg-brand-hover transition-all hover:-translate-y-0.5 shadow-sm">
              Calculate Calorie Deficit Target
            </a>
            <a href="/" class="inline-flex items-center gap-2 bg-surface text-ink font-bold py-3.5 px-7 rounded-xl border border-hairline hover:border-brand/30 hover:text-brand transition-all hover:-translate-y-0.5 shadow-sm">
              Full Calorie Calculator
            </a>
          </>
        )}
        <a href="/foods/" class="inline-flex items-center gap-2 bg-surface text-ink font-bold py-3.5 px-7 rounded-xl border border-hairline hover:border-brand/30 hover:text-brand transition-all hover:-translate-y-0.5 shadow-sm">
          Browse Food Database <span>&rarr;</span>
        </a>
      </div>
    </div>

  </div>
</Layout>
