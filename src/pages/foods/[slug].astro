---
import Layout from '../../layouts/Layout.astro';
import { foods } from '../../data/foods';
import type { FoodData } from '../../data/foods';

export async function getStaticPaths() {
  return foods.map((food) => {
    // Find 3 related foods (either same category, or just next in list)
    let related = foods.filter(f => f.category === food.category && f.slug !== food.slug).slice(0, 3);
    if (related.length < 3) {
        const others = foods.filter(f => f.slug !== food.slug && !related.find(r => r.slug === f.slug)).slice(0, 3 - related.length);
        related = [...related, ...others];
    }
    
    return {
      params: { slug: food.slug },
      props: { food, related },
    };
  });
}

interface Props {
  food: FoodData;
  related: FoodData[];
}

const { food, related } = Astro.props;

// Calculate burn time (walking at 3mph burns ~4 calories/minute for average adult)
const burnTimeWalking = Math.round(food.calories / 4);

const title = `How many calories are in 100g of ${food.name}? | Nutrition Facts`;
const description = `Find out exactly how many calories, protein, carbs, and fats are in 100g of ${food.name}. Plus, see how many minutes of walking it takes to burn it off!`;
---

<Layout title={title} description={description} path={`/foods/${food.slug}/`}>
  <div class="max-w-4xl mx-auto px-4 py-12 sm:px-6 lg:px-8">
    
    <!-- Hero / Headline -->
    <div class="text-center mb-12">
      <span class="inline-block py-1 px-3 rounded-full bg-brand/10 text-brand text-sm font-semibold tracking-wider mb-4 uppercase">{food.category}</span>
      <h1 class="text-4xl sm:text-5xl font-extrabold text-slate-900 tracking-tight mb-4">
        How many calories are in 100g of <span class="text-brand">{food.name}</span>?
      </h1>
      <p class="text-xl text-slate-600 max-w-2xl mx-auto">
        {food.description}
      </p>
    </div>

    <!-- Data Visualization / Macro Ring -->
    <div class="bg-white rounded-[2.5rem] p-8 shadow-xl border border-slate-100 mb-12 relative overflow-hidden">
      <div class="absolute top-0 left-0 w-full h-2 bg-gradient-to-r from-brand to-brand-light"></div>
      
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 items-center">
        <!-- Big Number -->
        <div class="text-center p-8 bg-slate-50 rounded-3xl">
          <p class="text-slate-500 font-medium mb-2 uppercase tracking-wide">Calories per 100g</p>
          <div class="text-7xl font-black text-slate-900 mb-4">{food.calories} <span class="text-3xl text-slate-400 font-bold">kcal</span></div>
          <div class="inline-flex items-center gap-2 bg-orange-100 text-orange-800 px-4 py-2 rounded-full font-medium text-sm">
            <span>🔥</span> Burns in {burnTimeWalking} mins of walking
          </div>
        </div>

        <!-- Macro Breakdown -->
        <div class="space-y-6">
          <h3 class="text-2xl font-bold text-slate-900 mb-4">Macronutrient Breakdown</h3>
          
          <!-- Protein -->
          <div>
            <div class="flex justify-between text-sm font-bold mb-2">
              <span class="text-slate-700">Protein</span>
              <span class="text-blue-600">{food.protein}g</span>
            </div>
            <div class="w-full bg-slate-100 rounded-full h-4 overflow-hidden">
              <div class="bg-blue-500 h-4 rounded-full" style={`width: ${Math.min(100, (food.protein / 100) * 100)}%`}></div>
            </div>
          </div>
          
          <!-- Carbs -->
          <div>
            <div class="flex justify-between text-sm font-bold mb-2">
              <span class="text-slate-700">Carbohydrates</span>
              <span class="text-emerald-600">{food.carbs}g</span>
            </div>
            <div class="w-full bg-slate-100 rounded-full h-4 overflow-hidden">
              <div class="bg-emerald-500 h-4 rounded-full" style={`width: ${Math.min(100, (food.carbs / 100) * 100)}%`}></div>
            </div>
          </div>

          <!-- Fats -->
          <div>
            <div class="flex justify-between text-sm font-bold mb-2">
              <span class="text-slate-700">Fats</span>
              <span class="text-amber-600">{food.fats}g</span>
            </div>
            <div class="w-full bg-slate-100 rounded-full h-4 overflow-hidden">
              <div class="bg-amber-500 h-4 rounded-full" style={`width: ${Math.min(100, (food.fats / 100) * 100)}%`}></div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- The Spiderweb (Internal Linking) -->
    <div class="mt-16">
      <h3 class="text-2xl font-bold text-slate-900 mb-6 border-b pb-4">Explore Similar Foods</h3>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-6">
        {related.map((item) => (
          <a href={`/foods/${item.slug}/`} class="block group">
            <div class="bg-white p-6 rounded-2xl border border-slate-200 shadow-sm hover:shadow-md transition-all group-hover:-translate-y-1">
              <span class="text-xs font-semibold text-slate-400 uppercase tracking-wider block mb-2">{item.category}</span>
              <h4 class="text-lg font-bold text-slate-900 mb-1 group-hover:text-brand transition-colors">{item.name}</h4>
              <p class="text-slate-500 font-medium">{item.calories} kcal / 100g</p>
            </div>
          </a>
        ))}
      </div>
      
      <div class="mt-10 text-center">
        <a href="/foods/" class="inline-block bg-slate-900 text-white font-bold py-4 px-8 rounded-xl hover:bg-slate-800 transition-colors">
          View Full Food Database
        </a>
      </div>
    </div>

  </div>
</Layout>
