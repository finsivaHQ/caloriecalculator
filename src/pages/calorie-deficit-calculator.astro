              <td id="deficit-250" class="px-5 py-2.5 text-right font-medium tabular-nums text-ink">2,300 kcal</td>
            </tr>
            <tr class="border-b border-hairline last:border-0">
              <td class="px-5 py-2.5 text-body">Standard deficit<span class="block text-xs text-mute">~0.5 kg / 1 lb weekly</span></td>
