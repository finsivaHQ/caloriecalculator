---
import CalculatorLayout from"../layouts/CalculatorLayout.astro";
import { inputCls, segOptCls, selectCls } from"../lib/ui";
import type { FaqItem } from"../lib/seo";
import Sources from"../components/ui/Sources.astro";
import ArticleImage from"../components/ui/ArticleImage.astro";

const faqs: FaqItem[] = [
  { q:"What is TDEE?", a:"Total Daily Energy Expenditure is the total number of calories you burn in a full day, including your resting metabolism (BMR) plus all movement, exercise, and digestion. It's the key number for managing your weight." },
  { q:"How is TDEE calculated?", a:"TDEE is your BMR multiplied by an activity factor between 1.2 (sedentary) and 1.9 (extra active). This calculator finds your BMR with the Mifflin-St Jeor equation and applies the multiplier you select." },
  { q:"How do I use my TDEE?", a:"Eat at your TDEE to maintain weight, below it to lose weight, and above it to gain. A 500-calorie daily deficit produces about 1 pound of weight loss per week." },
  { q:"Why is my TDEE higher than my BMR?", a:"Your BMR only covers resting functions. TDEE adds the energy you spend moving, exercising, and digesting food, so it is always higher — often by 20–90% depending on activity." },
  { q:"What activity level should I choose?", a:"Most people should select 'Light' or 'Moderate'. Only choose 'Extra active' if you have a physically demanding job AND exercise daily." },
  { q:"How often should I recalculate my TDEE?", a:"Recalculate every 4-6 weeks or when your weight changes by more than 5% since your last calculation." },
  { q:"Does muscle building increase TDEE?", a:"Yes. Each pound of muscle burns roughly 6-10 calories daily at rest, and strength training itself burns 200-400 calories per session." },
  { q:"What's the difference between TDEE and BMR?", a:"BMR is calories burned at complete rest. TDEE includes all daily activity — typically BMR × 1.3-1.9 depending on your lifestyle." },
  { q:"Can TDEE change with age?", a:"Yes. BMR decreases 2-3% per decade after age 30. Less activity with age also reduces overall TDEE." },
  { q:"How accurate is this TDEE calculator?", a:"Accuracy is within ±10% for most people. Individual variation exists based on genetics, muscle mass, and non-exercise activity." },
];
---

<CalculatorLayout
  title="Accurate TDEE Calculator | Find Your Total Daily Energy Expenditure"
  h1="TDEE Calculator"
  description="Discover your Total Daily Energy Expenditure (TDEE) with our highly accurate calculator. Find out an estimate of how many calories you burn per day for weight loss, maintenance, or muscle gain."
  intro="Your Total Daily Energy Expenditure (TDEE) is the exact number of calories your body burns every day. Use our free, highly accurate TDEE calculator to find your maintenance calories so you can effectively plan your weight loss or bulking diet."
  path="/tdee-calculator/"
  faqs={faqs}
>
  <div class="grid gap-6 lg:grid-cols-[minmax(0,380px)_1fr]" id="calc-root">
    <form id="calc-form" class="card p-5 sm:p-6" novalidate>
    <p role="note" class="mb-4 text-xs leading-relaxed text-mute">
      Example values are pre-filled. Enter your own details for accurate results.
    </p>
      <div class="mb-5 grid grid-cols-2 gap-1 rounded-full border border-hairline bg-canvas-soft p-1" role="tablist" aria-label="Unit system">
        <button type="button" data-unit="metric" class="unit-tab h-9 rounded-full text-sm font-medium bg-canvas text-ink shadow-sm" role="tab" aria-selected="true">Metric</button>
        <button type="button" data-unit="imperial" class="unit-tab h-9 rounded-full text-sm font-medium text-mute" role="tab" aria-selected="false">Imperial</button>
      </div>
      <fieldset class="mb-4">
        <legend class="mb-1.5 block text-sm font-medium text-ink">Gender</legend>
        <div class="grid grid-cols-2 gap-2">
          <label class={segOptCls}><input type="radio" name="sex" value="male" class="sr-only" checked />Male</label>
          <label class={segOptCls}><input type="radio" name="sex" value="female" class="sr-only" />Female</label>
        </div>
      </fieldset>
      <div class="mb-4 grid grid-cols-2 gap-3">
        <div class="space-y-1.5"><label for="age" class="block text-sm font-medium text-ink">Age</label><input id="age" type="number" min="15" max="100" value="30" class={inputCls} /></div>
        <div class="space-y-1.5"><label for="weight" class="block text-sm font-medium text-ink">Weight <span class="weight-unit text-mute">(kg)</span></label><input id="weight" type="number" inputmode="decimal" min="20" step="0.1" value="70" class={inputCls} /></div>
      </div>
      <div class="mb-4">
        <label class="mb-1.5 block text-sm font-medium text-ink">Height <span class="height-unit text-mute">(cm)</span></label>
        <div id="height-metric"><input id="height-cm" type="number" min="100" max="250" value="175" class={inputCls}  aria-label="Height in centimetres" /></div>
        <div id="height-imperial" class="hidden grid-cols-2 gap-3">
          <div class="relative"><input id="height-ft" type="number" min="3" max="8" value="5" class={inputCls}  aria-label="Height in feet" /><span class="pointer-events-none absolute right-3 top-1/2 -translate-y-1/2 text-xs text-mute">ft</span></div>
          <div class="relative"><input id="height-in" type="number" min="0" max="11" value="9" class={inputCls}  aria-label="Height in inches" /><span class="pointer-events-none absolute right-3 top-1/2 -translate-y-1/2 text-xs text-mute">in</span></div>
        </div>
      </div>
      <div class="mb-5 space-y-1.5">
        <label for="activity" class="block text-sm font-medium text-ink">Activity level</label>
        <div class="relative">
          <select id="activity" class={selectCls}>
            <option value="sedentary">Sedentary — little or no exercise</option>
            <option value="light">Lightly active — 1–3 days/week</option>
            <option value="moderate" selected>Moderately active — 3–5 days/week</option>
            <option value="active">Very active — 6–7 days/week</option>
            <option value="athlete">Extra active — hard exercise + job</option>
          </select>
          <svg class="pointer-events-none absolute right-3 top-1/2 h-4 w-4 -translate-y-1/2 text-mute" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m6 9 6 6 6-6" /></svg>
        </div>
      </div>
      <button type="submit" id="calc-btn" class="shimmer-btn inline-flex h-12 w-full items-center justify-center rounded-full bg-ink text-base font-medium text-canvas transition-all hover:opacity-90 active:scale-[0.99]">Calculate TDEE</button>
    </form>

    <div class="space-y-5">
      <div id="result-box" class="card p-6 sm:p-8 text-center transition-all duration-300">
        <p class="text-sm text-mute">Your Total Daily Energy Expenditure</p>
        <p class="mt-1"><span id="tdee-value" class="text-display-xl text-ink tabular-nums">2,556</span> <span class="text-lg text-mute">kcal/day</span></p>
        <p class="mt-2 text-sm text-body">Eat this much to maintain your current weight.</p>
      </div>
      <div class="card overflow-hidden">
        <div class="border-b border-hairline px-5 py-3"><h2 class="text-sm font-semibold text-ink">Calorie targets by goal</h2></div>
        <table class="w-full text-sm"><tbody id="goals-table"></tbody></table>
      </div>
    </div>
  </div>

    <Fragment slot="content">
     <ArticleImage src="/assets/images/articles/energy-level.svg" alt="Illustration of activity level and energy expenditure, showing how movement increases daily calorie needs." />

     <h2>The Ultimate Guide to Understanding Your TDEE</h2>
     <p>Total Daily Energy Expenditure — widely known as <strong>TDEE</strong> — is the total number of calories your body burns in a given 24-hour period. It encompasses every single biological process and physical action you undertake. From the silent, continuous beating of your heart to the intense sprint at the end of a grueling workout, every action requires energy. Knowing your TDEE isn't just a piece of fitness trivia; it is the absolute foundation of any successful nutrition plan, whether your goal is to lose stubborn body fat, build lean muscle mass, or maintain a healthy weight.</p>
     <p>In the world of diet and fitness, your TDEE represents your <strong>maintenance calorie</strong> baseline. This means if you consume the exact number of calories equal to your TDEE, your body weight will remain entirely stable. It is the equilibrium point of your metabolism. Eat below this number, and your body is forced to tap into stored energy (body fat) to make up the difference, resulting in weight loss. Eat above this number, and the surplus energy is stored as either muscle tissue (if you are resistance training) or body fat, leading to weight gain. Understanding this single metric gives you total control over your body composition.</p>

     <h2>The Science Behind Your Metabolism: The Four Pillars of TDEE</h2>
     <p>Many people mistakenly believe that their metabolism is just one static number, or that their workout is the main driver of calorie burn. In reality, your TDEE is a dynamic sum of four distinct components, each playing a crucial role in how you process energy.</p>
     <ul>
       <li><strong>BMR (Basal Metabolic Rate) — ~60–70% of TDEE:</strong> This is the baseline energy required to keep your body alive if you were to lay in bed all day without moving. It fuels your brain function, keeps your heart pumping, regulates your core body temperature, and powers cellular repair. BMR is heavily influenced by your genetics, age, gender, and, most importantly, your lean muscle mass. Because muscle is highly metabolically active tissue, a muscular person will have a significantly higher BMR than someone of the same weight with less muscle.</li>
       <li><strong>NEAT (Non-Exercise Activity Thermogenesis) — ~15–30% of TDEE:</strong> This is perhaps the most variable and underrated component of your metabolism. NEAT accounts for all the calories you burn through spontaneous, non-structured physical activity. This includes pacing while on the phone, fidgeting at your desk, doing household chores, walking from your car to the office, and even maintaining your posture. Two people of the same size and age can have vastly different TDEEs strictly because one works an active retail job on their feet while the other sits at a desk for eight hours.</li>
       <li><strong>TEF (Thermic Effect of Food) — ~10% of TDEE:</strong> Eating actually burns calories. The process of chewing, digesting, absorbing, and metabolizing food requires energy. Different macronutrients have different thermic effects. Protein is highly thermogenic, requiring your body to burn about 20-30% of the calories consumed just to process it. Carbohydrates burn about 5-10%, while dietary fats burn very little (0-3%). This is one reason why high-protein diets are so effective for fat loss; they subtly increase your daily energy expenditure just through digestion.</li>
       <li><strong>EAT (Exercise Activity Thermogenesis) — ~5–15% of TDEE:</strong> This represents the calories burned during deliberate, structured exercise—such as lifting weights, running, cycling, or attending a spin class. While exercise is incredibly important for cardiovascular health, insulin sensitivity, and building muscle, it makes up a surprisingly small percentage of your overall daily calorie burn for most people. You cannot out-train a bad diet solely by trying to increase your EAT.</li>
     </ul>

     <h2>How to Use This TDEE Calculator: Step-by-Step Guide</h2>
     <p>Getting an accurate reading from our TDEE calculator requires honest and precise inputs. Here is a step-by-step breakdown on how to use the tool effectively to ensure you get the most reliable data possible.</p>
     <ol>
       <li><strong>Select your unit of measurement:</strong> Choose whether you prefer Metric (kilograms and centimeters) or Imperial (pounds and feet/inches). The underlying math remains exactly the same.</li>
       <li><strong>Enter your gender and age:</strong> Biological sex and age play a significant role in determining your Basal Metabolic Rate. On average, men have more muscle mass and less body fat than women of the same weight, leading to a slightly higher metabolic rate. Additionally, metabolism naturally slows down by a few percentage points each decade as we age.</li>
       <li><strong>Input your exact weight and height:</strong> Be as accurate as possible. It is best to weigh yourself first thing in the morning, after using the restroom and before eating or drinking anything. Height should be measured without shoes.</li>
       <li><strong>Select your activity level honestly:</strong> This is where most people make a crucial error. <em>Overestimating</em> your activity level will give you a higher calorie target, which can completely stall your weight loss efforts. Let's break down the activity levels clearly:
         <ul>
           <li><strong>Sedentary:</strong> You work a desk job and do little to no structured exercise. (Multiplier: 1.2)</li>
           <li><strong>Lightly Active:</strong> You perform light exercise or sports 1-3 days a week, or you have a job that involves some light walking. (Multiplier: 1.375)</li>
           <li><strong>Moderately Active:</strong> You engage in moderate exercise or sports 3-5 days a week. You break a sweat regularly. (Multiplier: 1.55)</li>
           <li><strong>Very Active:</strong> You do hard exercise or sports 6-7 days a week, or you have a highly physical job like construction or nursing. (Multiplier: 1.725)</li>
           <li><strong>Extra Active:</strong> You perform very hard daily exercise AND have a physically demanding job, or you are training twice a day (e.g., professional athletes). (Multiplier: 1.9)</li>
         </ul>
       </li>
       <li><strong>Review your results:</strong> Click calculate to instantly see your maintenance calories, as well as calculated targets for aggressive weight loss, steady weight loss, and muscle gain.</li>
     </ol>

     <h2>Applying Your TDEE to Achieve Your Fitness Goals</h2>
     <p>Once you have your number, the next step is implementation. TDEE is just data; what you do with it dictates your results. Here is how to apply your TDEE depending on your primary objective.</p>
     
     <h3>1. Using TDEE for Weight Loss (The Calorie Deficit)</h3>
     <p>To lose weight, you must consume fewer calories than your body burns. This is called a caloric deficit. A pound of body fat contains roughly 3,500 calories of stored energy. Therefore, to lose one pound of fat per week, you need to create a deficit of 500 calories per day (500 x 7 = 3,500). If your calculated TDEE is 2,500 calories, your daily intake target for steady weight loss should be 2,000 calories.</p>
     <p>It is generally recommended not to exceed a 500-750 calorie deficit per day. Extreme deficits can lead to muscle loss, severe fatigue, nutrient deficiencies, and metabolic adaptation (where your body lowers its BMR to conserve energy). Slow and steady wins the race. Focus on eating high-volume, nutrient-dense foods like vegetables, lean proteins, and complex carbohydrates to stay full while eating fewer calories.</p>
     
     <h3>2. Using TDEE for Muscle Gain (The Caloric Surplus)</h3>
     <p>If your goal is to pack on muscle mass (bulking), you need to provide your body with excess energy. Building new tissue requires calories beyond your maintenance level. However, this does not mean you should eat everything in sight. A"dirty bulk" often leads to excessive fat gain alongside muscle growth.</p>
     <p>Instead, aim for a conservative surplus of 200-300 calories above your TDEE. This is enough to fuel intense workouts and maximize muscle protein synthesis while minimizing the accumulation of body fat. For example, if your TDEE is 2,500 calories, aim for 2,700-2,800 calories per day. Combine this surplus with a progressive overload resistance training program and adequate protein intake (roughly 0.8 to 1 gram per pound of body weight).</p>
     
     <h3>3. Using TDEE for Body Recomposition</h3>
     <p>Body recomposition is the holy grail of fitness: losing fat and building muscle simultaneously. This is most achievable for beginners, those returning from a long layoff, or individuals with a high body fat percentage. To attempt body recomposition, eat precisely at your TDEE maintenance level while keeping your protein intake very high and lifting weights intensely. Your body will use its stored fat for energy while using the dietary protein to build muscle tissue.</p>

     <h2>Why Your TDEE Fluctuates Over Time</h2>
     <p>It is critical to understand that your TDEE is a moving target. It is not a number that stays the same forever. As your body changes, your energy requirements change. Here are the main reasons why your TDEE will fluctuate:</p>
     <ul>
       <li><strong>Weight Loss:</strong> As you lose weight, you are carrying less mass. A smaller body requires fewer calories to operate and move around. If you lose 20 pounds, your TDEE will drop, meaning the calorie intake that used to help you lose weight might now be your new maintenance level. This is why plateaus happen. You must recalculate your TDEE every 10-15 pounds of weight loss.</li>
       <li><strong>Metabolic Adaptation:</strong> If you stay in a severe caloric deficit for a prolonged period, your body attempts to survive the"famine" by slowing down non-essential functions. You might unconsciously fidget less (lower NEAT), feel colder, and experience a slight dip in BMR. Taking occasional diet breaks—where you eat at maintenance for a week or two—can help reverse this adaptation.</li>
       <li><strong>Building Muscle:</strong> Conversely, if you add 10 pounds of lean muscle to your frame, your resting metabolism will increase. Muscle is a highly demanding tissue that requires constant energy for upkeep. </li>
       <li><strong>Changes in Routine:</strong> Switching from a job waiting tables to a desk job will drastically slash your NEAT, significantly lowering your TDEE even if your gym routine stays the same.</li>
     </ul>

     <h2>The Math: The Mifflin-St Jeor Equation</h2>
     <p>Our calculator utilizes the Mifflin-St Jeor equation to estimate your Basal Metabolic Rate before applying the activity multiplier. Introduced in 1990, this formula has been validated by numerous peer-reviewed studies as the most accurate predictive equation for modern populations, outperforming older models like the Harris-Benedict equation (which tends to overestimate calorie needs).</p>
     <p>For those interested in the mathematics, the formulas are as follows:</p>
     <pre>Men: (10 × weight in kg) + (6.25 × height in cm) - (5 × age in years) + 5
Women: (10 × weight in kg) + (6.25 × height in cm) - (5 × age in years) - 161</pre>
     <p>Once the BMR is calculated, it is multiplied by the appropriate activity factor (ranging from 1.2 to 1.9) to determine the final Total Daily Energy Expenditure.</p>

     <h2>Comprehensive TDEE Frequently Asked Questions (FAQ)</h2>
     <div class="faq-section">
       <h3>1. Should I eat back the calories I burn from exercise?</h3>
       <p>No. When you select your activity level in the calculator (e.g.,"Moderately Active"), the formula already accounts for the calories you burn during your workouts. If you eat back the calories displayed on your Apple Watch or treadmill, you are double-counting them and will likely erase your caloric deficit.</p>
       
       <h3>2. How accurate are TDEE calculators?</h3>
       <p>TDEE calculators provide a highly educated estimate, typically accurate within 10-15%. However, because they rely on generalized formulas, they cannot account for your unique hormonal profile, exact body fat percentage, or daily NEAT variations. Use the result as a starting baseline, track your weight for two weeks, and adjust your intake based on real-world results.</p>
       
       <h3>3. What is the difference between BMR and TDEE?</h3>
       <p>BMR (Basal Metabolic Rate) is the amount of calories your body burns at complete rest—like being in a coma. It only covers vital life functions. TDEE includes your BMR <em>plus</em> all the movement, exercise, and digestion you do in a normal day. TDEE will always be significantly higher than BMR.</p>
       
       <h3>4. Can a slow metabolism cause weight gain?</h3>
       <p>While metabolic conditions like hypothyroidism can lower your BMR slightly, they rarely account for more than a few hundred calories. In the vast majority of cases, unexpected weight gain is caused by a high caloric intake and a sedentary lifestyle (low TDEE), not a"broken" metabolism.</p>
       
       <h3>5. Does macronutrient split matter if calories are the same?</h3>
       <p>For pure weight loss, the most critical factor is total calories (Calories In vs Calories Out). However, for body composition (how you look and feel), macros matter immensely. Adequate protein preserves muscle mass during fat loss, while healthy fats support hormone production and carbs provide energy for intense workouts.</p>
       
       <h3>6. I've been eating below my TDEE but I'm not losing weight. Why?</h3>
       <p>If you aren't losing weight over a period of 3-4 weeks, you are not in a caloric deficit. This usually means one of three things: 1) You overestimated your activity level when calculating TDEE, 2) You are underestimating how much you are actually eating (sneaky calories from oils, sauces, or unmeasured snacks), or 3) You have lost weight and your TDEE has dropped to match your current intake.</p>
       
       <h3>7. How many calories should I eat if I am completely sedentary?</h3>
       <p>If you do zero exercise and have a desk job, you should multiply your BMR by 1.2 to find your TDEE. To lose weight, subtract 300-500 calories from that number. Note that eating extremely low calories is not recommended; it is often healthier to increase your activity level (add daily walks) rather than dropping calories to dangerously low levels.</p>

       <h3>8. Should my TDEE change on rest days?</h3>
       <p>Some people like to use calorie cycling, eating more on workout days and less on rest days. However, the standard TDEE calculation averages out your activity over the entire week. For simplicity and consistency, it is usually better to eat the same amount of calories every day, regardless of whether you train that specific day.</p>
       
       <h3>9. Do fitness trackers give a better TDEE reading?</h3>
       <p>Fitness trackers like Fitbit, Garmin, or Apple Watch can provide helpful data, but they are notoriously inaccurate at predicting calories burned during exercise, often overestimating by up to 30-40%. It is generally safer to rely on the standard TDEE formula and adjust based on scale weight trends.</p>

       <h3>10. Can I increase my TDEE permanently?</h3>
       <p>Yes. The most effective way to permanently raise your TDEE is to build lean muscle mass through resistance training. Because muscle tissue requires energy to maintain, a more muscular physique burns more calories around the clock. Adopting a generally more active lifestyle (taking the stairs, walking more) also permanently elevates your NEAT.</p>
     </div>

     <h2>Summary and Next Steps</h2>
     <p>Understanding your Total Daily Energy Expenditure is the first and most vital step on any fitness journey. It removes the guesswork from dieting, replacing frustration with straightforward mathematics. Remember that consistency is far more important than perfection. </p>
     <p>Now that you have your TDEE, pick a goal. Set a modest deficit for fat loss or a slight surplus for muscle gain. Track your food intake diligently using a kitchen scale and a macro-tracking app, monitor your weight trends over several weeks, and adjust your calories as your body transforms. You have the data—now execute the plan.</p>

     <Sources sources={[
       { label:"Dietary Reference Intakes for Energy — National Academies", href:"https://www.nap.edu/read/10490/chapter/1" },
       { label:"Energy expenditure — PubMed / NIH review", href:"https://pubmed.ncbi.nlm.nih.gov/2305711/" },
       { label:"A new predictive equation for resting energy expenditure in healthy individuals (Mifflin-St Jeor)", href:"https://pubmed.ncbi.nlm.nih.gov/2305711/" }
     ]} />
    </Fragment>
</CalculatorLayout>

<script>
  import { bmrMifflinStJeor, tdee, goalCalories, GOALS, type Sex, type ActivityKey, type GoalKey } from"../lib/calculations";
  import { lbToKg, ftInToCm } from"../lib/units";

  const root = document.getElementById("calc-root");
  if (root) {
    const $ = (id: string) => document.getElementById(id)!;
    let isDirty = false;





    function read() {
      const sex = (root!.querySelector('input[name="sex"]:checked') as HTMLInputElement).value as Sex;
      const age = parseFloat(($("age") as HTMLInputElement).value) || 0;
      const activity = ($("activity") as HTMLSelectElement).value as ActivityKey;
      let w = parseFloat(($("weight") as HTMLInputElement).value) || 0;
      let h: number;
      if (unit ==="imperial") { w = lbToKg(w); h = ftInToCm(parseFloat(($("height-ft") as HTMLInputElement).value) || 0, parseFloat(($("height-in") as HTMLInputElement).value) || 0); }
      else h = parseFloat(($("height-cm") as HTMLInputElement).value) || 0;
      return { sex, age, activity, w, h };
    }

    function render() {
      clearDirty();
      const { sex, age, activity, w, h } = read();
      if (w <= 0 || h <= 0 || age <= 0) return;
      const t = tdee(bmrMifflinStJeor(sex, age, h, w), activity);
      $("tdee-value").textContent = fmt(t);
      $("goals-table").innerHTML = (Object.keys(GOALS) as GoalKey[]).map((k) => {
        const c = goalCalories(t, k, sex);
        const hl = k ==="maintain";
        return `<tr class="border-b border-hairline last:border-0 ${hl ?"bg-brand/5" :""}"><td class="px-5 py-2.5 ${hl ?"font-medium text-ink" :"text-body"}">${GOALS[k].label}<span class="block text-xs text-mute">${GOALS[k].rate}</span></td><td class="px-5 py-2.5 text-right font-medium tabular-nums ${hl ?"text-ink" :"text-body"}">${fmt(c)}</td></tr>`;
      }).join("");
    }

    root.querySelectorAll<HTMLButtonElement>(".unit-tab").forEach((btn) => {
      btn.addEventListener("click", () => {
        const next = btn.dataset.unit as"metric" |"imperial";
        if (next === unit) return;
        unit = next;
        root.querySelectorAll<HTMLButtonElement>(".unit-tab").forEach((b) => { const on = b.dataset.unit === unit; b.setAttribute("aria-pressed", String(on)); b.classList.toggle("bg-canvas", on); b.classList.toggle("text-ink", on); b.classList.toggle("shadow-sm", on); b.classList.toggle("text-mute", !on); });
        $("height-metric").classList.toggle("hidden", unit ==="imperial");
        $("height-imperial").classList.toggle("hidden", unit ==="metric");
        $("height-imperial").classList.toggle("grid", unit ==="imperial");
        document.querySelectorAll(".weight-unit").forEach((e) => (e.textContent = unit ==="metric" ?"(kg)" :"(lb)"));
        document.querySelectorAll(".height-unit").forEach((e) => (e.textContent = unit ==="metric" ?"(cm)" :"(ft / in)"));
        const wi = $("weight") as HTMLInputElement; const cv = parseFloat(wi.value) || 0;
        if (cv) wi.value = (unit ==="imperial" ? cv * 2.2046226218 : cv / 2.2046226218).toFixed(1);
        markDirty();
      });
    });
    const form = $("calc-form") as HTMLFormElement;
    form.addEventListener("input", markDirty);
    form.addEventListener("submit", (e) => { e.preventDefault(); render(); });
  }
</script>
