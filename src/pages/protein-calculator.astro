---
import CalculatorLayout from "../layouts/CalculatorLayout.astro";
import { inputCls, selectCls } from "../lib/ui";
import type { FaqItem } from "../lib/seo";
import MedicalNote from "../components/ui/MedicalNote.astro";
import Sources from "../components/ui/Sources.astro";
import ArticleImage from "../components/ui/ArticleImage.astro";

const faqs: FaqItem[] = [
  { q: "How much protein do I need per day?", a: "Active adults generally need 1.2–2.0 g of protein per kilogram of body weight daily. Sedentary people need the RDA of 0.8 g/kg. Athletes and those in a calorie deficit should aim for 1.6–2.2 g/kg to preserve and build muscle." },
  { q: "Is too much protein dangerous?", a: "For healthy people, high-protein diets are safe. Intakes up to about 2 g/kg show no harm in research. People with existing kidney disease should consult a doctor before increasing protein significantly." },
  { q: "When should I eat protein?", a: "Spreading protein across 3–4 meals of 25–40 g each maximizes muscle protein synthesis. Including protein at every meal also improves fullness and helps control overall calorie intake." },
  { q: "What are good protein sources?", a: "Chicken, fish, lean beef, eggs, Greek yogurt, cottage cheese, tofu, tempeh, lentils, beans, and protein powder are excellent. Animal sources are 'complete', while combining plant sources covers all amino acids." },
  { q: "How many calories in 1 gram of protein?", a: "Protein contains approximately 4 calories per gram. This is a universal value used by nutrition scientists. One gram of protein provides 4 kcal of energy." },
  { q: "How many calories from protein per day?", a: "Multiply your protein grams by 4. For example, 150g of protein = 600 calories. Use our calculator to find your target and convert to calories automatically." },
  { q: "Protein to calories ratio?", a: "The ratio is 1 gram of protein to 4 calories. This means 25g protein = 100 calories, 50g = 200 calories. Fat is 9 calories per gram, carbs are 4 calories per gram." },
  { q: "Calories per gram of macronutrients?", a: "Protein: 4 kcal/g, Carbs: 4 kcal/g, Fat: 9 kcal/g. Alcohol is 7 kcal/g (not a macronutrient). This is how we calculate total calories from macros." },
  { q: "How to convert protein grams to calories?", a: "Multiply protein grams by 4. For 120g protein, that's 480 calories. Reverse: divide calories by 4 to get grams. 200 calories ÷ 4 = 50g protein." },
  { q: "What is the protein calorie calculator?", a: "Our protein calorie calculator shows how many calories your protein intake provides, helping you fit it into your daily calorie target from protein, carbs, and fat." },
  { q: "Calories from protein percentage?", a: "On a 2000-calorie diet, if 150g protein (600 cal), protein is 30%. Use our macro calculator to set protein percentage based on your goal." },
  { q: "Protein calorie chart?", a: "10g = 40 cal, 20g = 80 cal, 25g = 100 cal, 50g = 200 cal, 100g = 400 cal, 150g = 600 cal, 200g = 800 cal. Every gram of protein = 4 calories." },
  { q: "Does protein have more calories than carbs?", a: "No. Both protein and carbohydrates contain approximately 4 calories per gram. Fat is more calorie-dense at 9 calories per gram." },
  { q: "Why does protein have 4 calories per gram?", a: "When protein is metabolized, the carbon bonds release energy measured at 4 kcal/g through controlled scientific testing called bomb calorimetry." },
  { q: "Best protein sources for weight loss?", a: "Lean chicken breast, white fish, Greek yogurt, egg whites, and protein powder give high protein with fewer calories. Use the <a href="/">Calorie Calculator</a> to fit them into your plan." },
  { q: "Protein timing for muscle gain?", a: "Eat 25–40g protein every 3–4 hours. Post-workout protein within 2 hours maximizes muscle protein synthesis. Spread across 4–5 meals for best results." },
  { q: "How much protein for muscle gain vs weight loss?", a: "Weight loss: 1.6–2.2 g/kg to preserve muscle. Muscle gain: 1.6–2.2 g/kg plus a calorie surplus. Use the <a href="/">Calorie Calculator</a> to set your split." },
];
---

<CalculatorLayout
  title="Protein Calorie Calculator: How Much Protein Do I Need?"
  h1="Protein Calorie Calculator"
  description="Use our free protein calorie calculator to find out how many grams of protein you need to eat every day for muscle gain, fat loss, or maintenance."
  intro="Whether your goal is building muscle, losing fat, or maintaining your physique, getting enough protein is critical. Our free protein calculator determines your optimal daily intake based on your unique fitness goals."
  updated="2026-09-28"
  path="/protein-calculator/"
  faqs={faqs}
>
  <div class="grid gap-6 lg:grid-cols-[minmax(0,380px)_1fr]" id="calc-root">
    <form id="calc-form" class="card p-5 sm:p-6" novalidate>
    <p role="note" class="mb-4 text-xs leading-relaxed text-mute">
      Example values are pre-filled. Enter your own details for accurate results.
    </p>
      <div class="mb-5 grid grid-cols-2 gap-1 rounded-full border border-hairline bg-canvas-soft p-1" role="tablist" aria-label="Unit system">
        <button type="button" data-unit="metric" class="unit-tab h-9 rounded-full text-sm font-medium bg-canvas text-ink shadow-sm" role="tab" aria-selected="true">Metric</button>
        <button type="button" data-unit="imperial" class="unit-tab h-9 rounded-full text-sm font-medium text-mute" role="tab" aria-selected="false">Imperial</button>
      </div>
      <div class="space-y-4">
        <div class="space-y-1.5"><label for="weight" class="block text-sm font-medium text-ink">Weight <span class="u-wt text-mute">(kg)</span></label><input id="weight" type="number" inputmode="decimal" step="0.1" value="70" class={inputCls} /></div>
        <div class="space-y-1.5">
          <label for="activity" class="block text-sm font-medium text-ink">Activity / goal</label>
          <div class="relative">
            <select id="activity" class={selectCls}>
              <option value="sedentary">Sedentary — maintain health</option>
              <option value="light">Light activity — general fitness</option>
              <option value="moderate" selected>Moderate — weight loss / muscle</option>
              <option value="active">Active — athlete</option>
              <option value="athlete">Athlete — build / preserve muscle</option>
            </select>
            <svg class="pointer-events-none absolute right-3 top-1/2 h-4 w-4 -translate-y-1/2 text-mute" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m6 9 6 6 6-6" /></svg>
          </div>
        </div>
      </div>
      <button type="submit" id="calc-btn" class="shimmer-btn mt-5 inline-flex h-12 w-full items-center justify-center rounded-full bg-ink text-base font-medium text-canvas transition-all hover:opacity-90 active:scale-[0.99]">Calculate Protein</button>
    </form>

    <div class="space-y-5">
      <div id="result-box" class="card p-6 sm:p-8 text-center transition-all duration-300">
        <p class="text-sm text-mute">Recommended daily protein</p>
        <p class="mt-1"><span id="p-range" class="text-display-xl text-ink tabular-nums">84–112</span> <span class="text-lg text-mute">g</span></p>
        <p class="mt-2 text-sm text-body">That's <span id="p-calories" class="font-medium text-brand">~352–448</span> calories from protein.</p>
      </div>
      <div class="grid grid-cols-2 gap-4">
        <div class="card p-5"><p class="text-xs uppercase tracking-wide text-mute">Per meal (4 meals)</p><p id="p-meal" class="mt-1 text-display-sm text-ink tabular-nums">~28 g</p></div>
        <div class="card p-5"><p class="text-xs uppercase tracking-wide text-mute">Calories per gram</p><p class="mt-1 text-display-sm text-ink tabular-nums">4 kcal</p></div>
      </div>
      <div class="card overflow-hidden">
        <table class="w-full text-sm">
          <caption class="sr-only">Protein calorie conversion table</caption>
          <thead>
            <tr class="border-b border-hairline text-left text-xs uppercase tracking-wide text-mute">
              <th scope="col" class="px-4 py-3 font-medium">Grams</th>
              <th scope="col" class="px-4 py-3 text-right font-medium">Calories</th>
            </tr>
          </thead>
          <tbody id="protein-table">
            <tr class="border-b border-hairline"><td class="px-4 py-2.5 text-body">25g</td><td class="px-4 py-2.5 text-right tabular-nums">100 kcal</td></tr>
            <tr class="border-b border-hairline"><td class="px-4 py-2.5 text-body">50g</td><td class="px-4 py-2.5 text-right tabular-nums">200 kcal</td></tr>
            <tr class="border-b border-hairline"><td class="px-4 py-2.5 text-body">100g</td><td class="px-4 py-2.5 text-right tabular-nums">400 kcal</td></tr>
            <tr class="border-b border-hairline"><td class="px-4 py-2.5 text-body">150g</td><td class="px-4 py-2.5 text-right tabular-nums">600 kcal</td></tr>
            <tr><td class="px-4 py-2.5 text-body">200g</td><td class="px-4 py-2.5 text-right tabular-nums">800 kcal</td></tr>
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <Fragment slot="content">
    <MedicalNote />

    <ArticleImage src="/assets/images/articles/protein-structure.svg" alt="Illustration of amino acid structures forming protein molecules." />

    <h2>Quick Answer: How Many Calories in 1 Gram of Protein?</h2>
    <p class="text-display-sm font-semibold text-ink"><strong>One gram of protein equals approximately 4 calories.</strong></p>
    <p>This is a scientific fact established through controlled testing. Whether you eat chicken, fish, eggs, or protein powder, protein always provides 4 kcal per gram. This is why converting protein to calories is simple: multiply grams by 4.</p>

    <h2>Protein Calorie Conversion Made Simple</h2>
    <p>The protein to calories formula is straightforward:</p>
    <div class="not-prose grid gap-3 sm:grid-cols-3">
      <div class="card p-4 text-center">
        <p class="text-xs uppercase text-mute">Formula</p>
        <p class="mt-1 font-semibold text-ink">Protein (g) × 4 = Calories</p>
      </div>
      <div class="card p-4 text-center">
        <p class="text-xs uppercase text-mute">Reverse</p>
        <p class="mt-1 font-semibold text-ink">Calories ÷ 4 = Protein (g)</p>
      </div>
      <div class="card p-4 text-center">
        <p class="text-xs uppercase text-mute">Example</p>
        <p class="mt-1 font-semibold text-ink">150g × 4 = 600 kcal</p>
      </div>
    </div>

    <h2>How Much Protein Per Day?</h2>
    <p>Daily protein needs depend on your weight, activity level, and goals. Use the <a href="/protein-calculator/">protein calculator</a> above to find your personalized range, or refer to these general guidelines:</p>
    <ul>
      <li><strong>Sedentary adults:</strong> 0.8 g/kg — minimum to prevent deficiency</li>
      <li><strong>General health:</strong> 1.0–1.2 g/kg — maintenance and daily vitality</li>
      <li><strong>Active / weight loss:</strong> 1.6–2.2 g/kg — preserve muscle while dieting</li>
      <li><strong>Muscle building:</strong> 1.6–2.2 g/kg — maximize muscle protein synthesis</li>
      <li><strong>Athletes:</strong> 1.4–2.0 g/kg — performance and recovery</li>
    </ul>

    <h2>Best Protein Sources</h2>
    <p>Some foods pack more protein per calorie than others. Prioritize these for efficient intake:</p>
    <table>
      <thead><tr><th scope="col">Food</th><th scope="col">Protein per 100g</th><th scope="col">Calories per 100g</th><th scope="col">Protein %</th></tr></thead>
      <tbody>
        <tr><td>Chicken breast (cooked)</td><td>31g</td><td>165 kcal</td><td>75%</td></tr>
        <tr><td>White fish (cod)</td><td>20–25g</td><td>80–100 kcal</td><td>80–90%</td></tr>
        <tr><td>Greek yogurt (0% fat)</td><td>10g</td><td>59 kcal</td><td>68%</td></tr>
        <tr><td>Eggs</td><td>13g</td><td>72 kcal</td><td>72%</td></tr>
        <tr><td>Whey protein isolate</td><td>80–90g</td><td>300–350 kcal</td><td>96%</td></tr>
        <tr><td>Lentils (cooked)</td><td>9g</td><td>116 kcal</td><td>31%</td></tr>
      </tbody>
    </table>

    <h2>Protein Timing</h2>
    <p>Total daily protein matters most, but timing amplifies results. Research shows 25–40 grams of protein per meal maximally stimulates muscle protein synthesis. Eating more in one sitting does not help — it is the per-meal amount that counts.</p>
    <p>For a 150g daily target, aim for 4 meals of ~37g each. That is roughly 150 calories from protein per meal. Use the <a href="/meal-calorie-calculator/">meal calorie calculator</a> to plan portions, or the <a href="/recipe-calorie-calculator/">recipe calorie calculator</a> for home cooking.</p>

    <h2>Protein for Weight Loss vs Muscle Gain</h2>
    <p>Protein needs shift slightly depending on your goal:</p>
    <ul>
      <li><strong>Weight loss:</strong> Higher protein (1.6–2.2 g/kg) preserves muscle during a calorie deficit and increases fullness. Use the <a href="/">calorie calculator</a> to set your deficit.</li>
      <li><strong>Muscle gain:</strong> Same high protein range plus a small calorie surplus. Protein provides the building blocks; extra calories provide the energy for growth.</li>
      <li><strong>Maintenance:</strong> 1.2–1.6 g/kg keeps muscle stable without aggressive dieting or bulking.</li>
    </ul>

    <h2>Calories in Protein vs Carbs vs Fat</h2>
    <table>
      <thead><tr><th scope="col">Macronutrient</th><th scope="col">Calories per gram</th><th scope="col">Percentage of total</th></tr></thead>
      <tbody>
        <tr><td>Protein</td><td class="text-brand font-semibold">4 kcal</td><td>Highest thermic effect (20-30%)</td></tr>
        <tr><td>Carbohydrates</td><td class="text-brand font-semibold">4 kcal</td><td>Primary energy source</td></tr>
        <tr><td>Fat</td><td class="text-brand font-semibold">9 kcal</td><td>Most calorie-dense macro</td></tr>
        <tr><td>Alcohol</td><td class="text-warning">7 kcal</td><td>Not a macronutrient</td></tr>
      </tbody>
    </table>

    <h2>Why 4 Calories Per Gram Matters</h2>
    <p>Understanding protein calories helps you:</p>
    <ul>
      <li><strong>Track accurately:</strong> Know an estimate of how many calories your protein intake provides</li>
      <li><strong>Plan meals:</strong> Build meals that hit both protein and calorie targets</li>
      <li><strong>Compare macros:</strong> See how protein stacks up against carbs and fat</li>
      <li><strong>Adjust ratios:</strong> Set protein percentages in your macro split</li>
    </ul>

    <h2>Protein Calorie Chart (Quick Reference)</h2>
    <p>Common protein amounts and their calorie equivalents:</p>
    <table>
      <thead><tr><th scope="col">Protein (g)</th><th scope="col">Calories</th><th scope="col">Examples</th></tr></thead>
      <tbody>
        <tr><td>25g</td><td>100 kcal</td><td>1 scoop whey, 4 oz chicken</td></tr>
        <tr><td>50g</td><td>200 kcal</td><td>1 cup Greek yogurt + 2 eggs</td></tr>
        <tr><td>100g</td><td>400 kcal</td><td>6 oz salmon, 1 cup cottage cheese</td></tr>
        <tr><td>150g</td><td>600 kcal</td><td>Athlete daily target</td></tr>
        <tr><td>200g</td><td>800 kcal</td><td>High-protein 2000-calorie plan</td></tr>
      </tbody>
    </table>

    <h2>Protein Percentage in Your Diet</h2>
    <p>For a 2000-calorie diet:</p>
    <ul>
      <li><strong>15% protein:</strong> 300g protein = 1200 kcal (low for most goals)</li>
      <li><strong>25% protein:</strong> 125g protein = 500 kcal (balanced)</li>
      <li><strong>30% protein:</strong> 150g protein = 600 kcal (muscle-friendly)</li>
      <li><strong>35% protein:</strong> 179g protein = 715 kcal (high-protein)</li>
    </ul>
    <p>Use our <a href="/">Calorie Calculator</a> to set your ideal protein percentage.</p>

    <h2>Putting It Into Practice</h2>
    <p>Spread your protein across meals:</p>
    <ul>
      <li><strong>Optimal per meal:</strong> 25–40 g (100–160 kcal) for muscle synthesis</li>
      <li><strong>Frequency:</strong> 3–4 meals for steady amino acid levels</li>
      <li><strong>Combine with:</strong> Your <a href="/">daily calorie target</a> and <a href="/">macro split</a></li>
    </ul>

    <Sources sources={[
      { label: "Institute of Medicine — Dietary Reference Intakes for Energy, Carbohydrate, Fiber, Fat, Fatty Acids, Cholesterol, Protein, and Amino Acids (2005)", href: "https://www.nationalacademies.org/publication/dietary-reference-intakes-for-energy-carbohydrate-fiber-fat-fatty-acids-cholesterol-protein-and-amino-acids" },
      { label: "Academy of Nutrition and Dietetics — Protein and Amino Acids (position paper)", href: "https://www.hsph.harvard.edu/nutritionsource/what-should-you-eat/protein/" },
      { label: "Mayo Clinic — Nutrition: Protein and daily intake recommendations", href: "https://www.mayoclinic.org/healthy-lifestyle/nutrition-and-healthy-eating/in-depth/protein/art-20045169" },
    ]} />
  </Fragment>
</CalculatorLayout>

<script>
  import { proteinTargetG, type ActivityKey } from "../lib/calculations";
  import { lbToKg } from "../lib/units";

  const root = document.getElementById("calc-root");
  if (root) {
    const $ = (id: string) => document.getElementById(id)!;
    let isDirty = false;

    function markDirty() {
      if (isDirty) return;
      isDirty = true;
      const box = document.getElementById("result-box") || document.getElementById("calc-results");
      if (box) {
        box.querySelectorAll(".tabular-nums").forEach((el) => {
          el.textContent = "-.-";
        });
      }
      const btn = document.getElementById("calc-btn");
      if (btn) btn.classList.add("is-dirty");
    }

    function clearDirty() {
      isDirty = false;
      const box = $("result-box");
      if (box) box.classList.remove("opacity-40", "grayscale");
      const btn = $("calc-btn");
      if (btn) btn.classList.remove("is-dirty");
    }
    let unit: "metric" | "imperial" = "metric";

    function render() {
      clearDirty();
      let w = parseFloat(($("weight") as HTMLInputElement).value) || 0;
      if (unit === "imperial") w = lbToKg(w);
      if (w <= 0) return;
      const activity = ($("activity") as HTMLSelectElement).value as ActivityKey;
      const { min, max } = proteinTargetG(w, activity);
      $("p-range").textContent = `${min}–${max}`;
      const avg = (min + max) / 2;
      $("p-meal").textContent = `~${Math.round(avg / 4)} g`;
      $("p-calories").textContent = `~${Math.round(min * 4)}–${Math.round(max * 4)} kcal`;
    }

    root.querySelectorAll<HTMLButtonElement>(".unit-tab").forEach((btn) => {
      btn.addEventListener("click", () => {
        const next = btn.dataset.unit as "metric" | "imperial";
        if (next === unit) return; unit = next;
        root.querySelectorAll<HTMLButtonElement>(".unit-tab").forEach((b) => { 
          const on = b.dataset.unit === unit; 
          b.setAttribute("aria-pressed", String(on)); 
          b.classList.toggle("bg-canvas", on); 
          b.classList.toggle("text-ink", on); 
          b.classList.toggle("shadow-sm", on); 
          b.classList.toggle("text-mute", !on); 
        });
        document.querySelectorAll(".u-wt").forEach((e) => (e.textContent = unit === "metric" ? "(kg)" : "(lb)"));
        const wi = $("weight") as HTMLInputElement; const cv = parseFloat(wi.value) || 0;
        if (cv) wi.value = (unit === "imperial" ? cv * 2.2046226218 : cv / 2.2046226218).toFixed(1);
        markDirty();
      });
    });
    const form = $("calc-form") as HTMLFormElement;
    form.addEventListener("input", markDirty);
    form.addEventListener("submit", (e) => { e.preventDefault(); render(); });
  }
</script>
