---
import Layout from "../../layouts/Layout.astro";
import Section from "../../components/ui/Section.astro";
import { breadcrumbSchema } from "../../lib/seo";
import { ALL_CALCULATORS } from "../../data/site";

const allCalculators = ALL_CALCULATORS.filter(c => c.href !== "/");

const jsonLd = [breadcrumbSchema([{ name: "Home", path: "/" }, { name: "Resources", path: "/resources/" }])];
---

<Layout
  title="Resources & Calculators — Calorie Calculator Free"
  description={`Explore all ${allCalculators.length} free calculators and reference resources for BMR, TDEE, and daily calorie needs.`}
  canonical="/resources/"
  jsonLd={jsonLd}
>
  <header class="relative overflow-hidden border-b border-hairline">
    <div class="bg-grid pointer-events-none absolute inset-0 -z-10 opacity-50" aria-hidden="true"></div>
    <div class="container-page py-12 sm:py-16">
      <p class="text-sm font-medium text-brand">Resources</p>
      <h1 class="mt-2 text-display-lg text-ink">All Calculators</h1>
      <p class="mt-4 max-w-2xl text-lg text-body">A complete toolkit for calories, body composition, and nutrition.</p>
    </div>
  </header>

  <Section class="bg-canvas-soft">
    <div class="container-page py-12">
      <div class="mb-10 text-center">
        <h2 class="text-display-md text-gradient">Explore all {allCalculators.length} calculators</h2>
        <p class="mx-auto mt-3 max-w-xl text-body">
          Select a tool below to calculate your specific goals.
        </p>
      </div>
      <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
        {
          allCalculators.map((c) => (
            <a
              href={c.href}
              class="card bg-surface group flex items-center justify-between gap-3 p-4 transition-all hover:border-hairline-strong hover:bg-canvas-soft shadow-sm"
            >
              <div>
                <span class="block text-sm font-medium text-ink">{c.label}</span>
                {c.desc && <span class="block text-xs text-mute">{c.desc}</span>}
              </div>
              <svg class="h-4 w-4 shrink-0 text-mute transition-transform group-hover:translate-x-0.5 group-hover:text-ink" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
            </a>
          ))
        }
      </div>
    </div>
  </Section>
</Layout>
