---
import CalculatorLayout from"../layouts/CalculatorLayout.astro";
import { inputCls } from"../lib/ui";
import Button from"../components/ui/Button.astro";
import type { FaqItem } from"../lib/seo";
import ArticleImage from"../components/ui/ArticleImage.astro";
import Sources from"../components/ui/Sources.astro";

const faqs: FaqItem[] = [
  { q:"How do I calculate calories in a recipe?", a:"Add up the calories for each ingredient, then divide by the number of servings. Use the food calories search to find per-ingredient calories, then plug them into this calculator." },
  { q:"How many calories per serving?", a:"Total recipe calories divided by the number of servings gives calories per serving. For example, 1200 calories total across 4 servings = 300 calories per serving." },
  { q:"Does cooking change calorie content?", a:"Cooking can slightly change water content and concentration, but calorie changes are usually small. Weigh raw ingredients for more consistent tracking, or use standard nutrition data." },
  { q:"Should I weigh ingredients raw or cooked for calories?", a:"Weighing raw gives more consistent values. If you weigh cooked food, use cooked-state nutrition data or standard reference tables." },
  { q:"How do I estimate calories for homemade meals?", a:"Break the meal into ingredients, find calories for each portion, and sum them. This calculator automates the math once you enter ingredient calories." },
  { q:"What is the best way to track recipe calories?", a:"Use a calorie calculator with ingredient-level inputs, log portions in a nutrition app, and keep a standard recipe card for frequent meals." },
  { q:"Can I reduce calories in my favorite recipes?", a:"Yes. Reduce oil, use lower-calorie swaps, increase vegetables, and control portion sizes. Use the <a href="/">Calorie Calculator</a> to check the balance." },
  { q:"How many calories in a homemade meal?", a:"Homemade meals vary widely. A 500-calorie meal might be a salad with grilled chicken; a heavier pasta dish can exceed 800 calories. Calculate each recipe with this tool." },
];
---

<CalculatorLayout
  title="Recipe Calorie Calculator — Calories Per Serving Calculator (Free)"
  h1="Recipe Calorie Calculator"
  description="Free recipe calorie calculator. Add ingredients and servings to estimate total recipe calories and calories per serving."
  intro="Estimate the calorie count for any homemade recipe. Enter your ingredients and portions to get an instant breakdown."
  path="/recipe-calorie-calculator/"
  faqs={faqs}
>
  <div class="grid gap-6 lg:grid-cols-[minmax(0,380px)_1fr]" id="calc-root">
    <form id="calc-form" class="card p-5 sm:p-6" novalidate>
      <p role="note" class="mb-4 text-xs leading-relaxed text-mute">Example values are pre-filled. Enter your own details for accurate results.</p>
      <div class="mb-4 space-y-1.5">
        <label for="servings" class="block text-sm font-medium text-ink">Servings</label>
        <input id="servings" type="number" inputmode="numeric" min="1" max="50" value="4" class={inputCls} />
      </div>
      <div id="ingredients" class="mb-4 space-y-2"></div>
      <button type="button" id="add-ingredient" class="mb-5 inline-flex h-10 items-center justify-center rounded-full border border-hairline px-4 text-sm font-medium text-body transition-colors hover:text-ink">Add ingredient</button>
      <button type="button" id="calculate-btn" class="inline-flex h-12 w-full items-center justify-center rounded-full bg-ink text-base font-medium text-canvas transition-all hover:opacity-90 active:scale-[0.99]">Calculate Recipe Calories</button>
    </form>

    <div class="space-y-5">
      <div id="result-box" class="card p-6 sm:p-8 text-center transition-all duration-300">
        <p class="text-sm text-mute">Total recipe calories</p>
        <p class="mt-1"><span id="recipe-total" class="text-display-xl text-ink tabular-nums">0</span> <span class="text-lg text-mute">kcal</span></p>
        <p class="mt-2 text-sm text-body"><span id="recipe-per" class="text-ink">0</span> <span class="text-mute">kcal per serving</span></p>
      </div>
      <div class="card overflow-hidden">
        <div class="border-b border-hairline px-5 py-3"><h2 class="text-sm font-semibold text-ink">Ingredient breakdown</h2></div>
        <table class="w-full text-sm"><thead><tr class="border-b border-hairline text-left text-xs uppercase tracking-wide text-mute"><th class="px-5 py-3 font-medium">Ingredient</th><th class="px-5 py-3 text-right font-medium">Calories</th></tr></thead><tbody id="recipe-table"></tbody></table>
      </div>
    </div>
  </div>

    <Fragment slot="content">
    <ArticleImage src="/assets/images/articles/recipe-book.svg" alt="Illustration of a recipe book with ingredients list for calculating recipe calories." />
    
    <h2>The Definitive Guide to Calculating Recipe Calories, Yields, and Serving Sizes</h2>
    <p>Preparing home-cooked meals is universally celebrated as the healthiest, most budget-friendly way to eat. However, when it comes to nutritional tracking, homemade multi-ingredient recipes represent the single largest blind spot for fitness enthusiasts and dieters alike. Clinical research demonstrates that when individuals attempt to estimate the caloric content of home-cooked casseroles, soups, curries, and stir-fries by visual estimation, they underestimate actual intake by an astonishing 30% to 50%.</p>
    <p>The culprit is rarely the main protein or vegetable source; it is the compounding effect of cooking oils, volumetric measuring inaccuracies, and the complex thermodynamic changes that occur during cooking. Our recipe calorie calculator solves this dilemma by breaking down composite dishes into verified constituent parts, allowing you to establish exact per-serving energy totals and macronutrient ratios with scientific precision.</p>

    <h2>The Raw vs. Cooked Weight Paradox: Why Density Changes Everything</h2>
    <p>The most ubiquitous mistake in home recipe tracking is confusing <strong>raw ingredient weights</strong> with <strong>cooked ingredient weights</strong>. The laws of thermodynamics dictate that heating food causes substantial moisture migration—either through water evaporation (which concentrates caloric density) or water absorption (which dilutes caloric density).</p>

    <h3>1. Water Loss & Caloric Concentration (Meats & Vegetables)</h3>
    <p>When you roast, sear, or bake animal proteins, muscle fibers denature and expel water. A 500-gram raw portion of 85% lean ground beef contains approximately 1,075 calories (roughly 215 kcal per 100g raw). During cooking, that beef may lose 25% of its weight in evaporated moisture and rendered grease, shrinking the final cooked patty to just 375 grams.</p>
    <p>Those 1,075 calories now reside in only 375 grams of food. If you scoop out 100 grams of the cooked meat and inadvertently log it using a "raw ground beef" database entry (215 kcal), you will actually be consuming roughly 287 calories—an invisible 33% tracking error on a single ingredient.</p>

    <h3>2. Water Absorption & Caloric Dilution (Grains, Starches & Legumes)</h3>
    <p>The inverse phenomenon occurs when boiling grains and starches. Consider dry white rice or pasta:</p>
    <ul>
      <li><strong>Dry White Jasmine Rice:</strong> 100 grams dry yields approximately 360 calories.</li>
      <li><strong>Cooked Rice:</strong> During boiling, the starches absorb roughly two times their weight in water, swelling to approximately 280–300 grams.</li>
    </ul>
    <p>Water contains zero calories. Therefore, 100 grams of cooked rice contains only ~130 calories. If a user logs 200 grams of cooked rice as "dry rice" in their fitness app, they mistakenly record 720 calories instead of the true 260 calories—artificially slashing their food intake and causing severe nutritional deficits.</p>

    <h2>Raw vs. Cooked Yield Reference Matrix</h2>
    <p>Use the data table below to understand typical yield ratios and caloric density shifts for common whole-food staples:</p>
    <table>
      <thead>
        <tr>
          <th scope="col">Ingredient</th>
          <th scope="col">Raw Weight</th>
          <th scope="col">Typical Cooked Weight</th>
          <th scope="col">Moisture Shift</th>
          <th scope="col">True Calorie Content</th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <td>Boneless Chicken Breast</td>
          <td>100 g (Raw)</td>
          <td>~75–80 g (Cooked)</td>
          <td>-20% to -25% (Water Loss)</td>
          <td>~120 kcal (Raw) = ~120 kcal (Cooked)</td>
        </tr>
        <tr>
          <td>Ground Beef (85/15)</td>
          <td>100 g (Raw)</td>
          <td>~70–75 g (Cooked)</td>
          <td>-25% to -30% (Moisture/Fat Render)</td>
          <td>~215 kcal (Raw) = ~215 kcal (Cooked)</td>
        </tr>
        <tr>
          <td>White Basmati Rice</td>
          <td>100 g (Dry)</td>
          <td>~280–300 g (Cooked)</td>
          <td>+180% to +200% (Water Absorption)</td>
          <td>~360 kcal (Dry) = ~360 kcal (Cooked)</td>
        </tr>
        <tr>
          <td>Rolled Oats</td>
          <td>50 g (Dry)</td>
          <td>~175–200 g (Cooked/Porridge)</td>
          <td>+250% to +300% (Liquid Absorption)</td>
          <td>~190 kcal (Dry) = ~190 kcal (Cooked)</td>
        </tr>
        <tr>
          <td>Dry Red Lentils</td>
          <td>100 g (Dry)</td>
          <td>~250 g (Cooked)</td>
          <td>+150% (Water Absorption)</td>
          <td>~340 kcal (Dry) = ~340 kcal (Cooked)</td>
        </tr>
      </tbody>
    </table>

    <h2>The Batch Cooking Protocol: Calculating Serving Sizes by Grams</h2>
    <p>Many home cooks attempt to divide a large pot of chili or soup into "equal portions" by eyeballing bowls. Because heavy beans and meat sink to the bottom while broths float to the top, scoop-based portioning produces massive variances in macronutrient distribution. To achieve clinical accuracy, implement the <strong>Total Gram Batch Method</strong>:</p>
    <ol>
      <li><strong>Weigh Raw Ingredients:</strong> Place your mixing bowl on a digital kitchen scale, hit tare (zero), and log every raw ingredient, vegetable, sauce, and cooking oil into the recipe calculator.</li>
      <li><strong>Record Total Recipe Calories:</strong> Sum the raw components to determine the master caloric total for the entire batch (e.g., 3,200 total calories).</li>
      <li><strong>Tare Your Empty Pot / Dutch Oven:</strong> Before beginning to cook, record the weight of your empty cooking pot in grams (e.g., pot weight = 1,450 g).</li>
      <li><strong>Weigh the Finished Dish:</strong> Once cooking is complete, place the entire pot containing the finished food back onto your heat-resistant scale. Subtract the pot's weight to obtain the net cooked yield in grams (e.g., total finished stew = 2,000 g).</li>
      <li><strong>Calculate Calorie Density Per Gram:</strong> Divide total recipe calories by total cooked grams (3,200 divided by 2,000 = 1.6 kcal per gram).</li>
      <li><strong>Serve with Precision:</strong> If you ladle a 350-gram bowl for lunch, your meal is exactly 350 x 1.6 = 560 calories.</li>
    </ol>

    <h2>Hidden Recipe Ingredients That Sabotage Tracking</h2>
    <p>When auditing home-cooked meals, nutritional researchers consistently find that the majority of unexplained caloric surplus comes from three sneaky culprits:</p>
    <ul>
      <li><strong>Free-Poured Cooking Fats:</strong> Cooking sprays, extra virgin olive oil, and grass-fed butter are healthy, but oil is the most calorically dense substance on Earth at 9 kcal per gram. A single generous, unmeasured "glug" of olive oil into your sauté pan routinely adds 200–300 unrecorded calories.</li>
      <li><strong>Marinade Retention vs. Discard:</strong> If you marinate meat in 100g of teriyaki sauce and oil, do not log the entire 100g if half of the liquid remains in the prep dish. Weigh the leftover marinade and subtract it from your logged raw totals.</li>
      <li><strong>Alcohol in Reductions:</strong> A common kitchen assumption is that alcohol evaporates completely during simmering. Food science studies demonstrate that boiling wine or spirits for 15 minutes still leaves roughly 40% of the alcohol content intact; even after 2.5 hours of braising, approximately 5% of the alcohol and its caloric energy remains.</li>
    </ul>
    <p>Once you calculate your per-serving recipe total, learn how to split your daily targets with our <a href="/meal-calorie-calculator/">meal calorie calculator</a> or verify your personal energy deficit goals with our <a href="/calorie-deficit-calculator/">calorie deficit calculator</a>.</p>
    
    <Sources sources={[
      { label:"USDA FoodData Central � nutrition data", href:"https://fdc.nal.usda.gov/" },
      { label:"Academy of Nutrition and Dietetics � How to Count Calories", href:"https://www.niddk.nih.gov/health-information/weight-management/myplate-mywins" },
    ]} />
  </Fragment>
</CalculatorLayout>

<script>
  const root = document.getElementById("calc-root");
  if (root) {
    const $ = (id: string) => document.getElementById(id)!;
    let isDirty = false;



    function clearDirty() {
      isDirty = false;
      const box = $("result-box");
      if (box) box.classList.remove("opacity-40","grayscale");
      const btn = $("calc-btn");
      if (btn) btn.classList.remove("is-dirty");
    }
    let ingredients: { name: string; calories: number }[] = [];

    function addRow(name ="", calories ="") {
      const row = document.createElement("div");
      row.className ="grid grid-cols-[1fr_120px_auto] gap-2 items-center";
      row.innerHTML = `<input class="ing-name w-full h-10 rounded-lg border border-hairline bg-canvas px-3 text-sm text-ink placeholder:text-mute focus:border-brand focus:outline-none" value="${name}" placeholder="Ingredient" /><input class="ing-cal w-full h-10 rounded-lg border border-hairline bg-canvas px-3 text-sm text-ink placeholder:text-mute focus:border-brand focus:outline-none" inputmode="numeric" value="${calories}" placeholder="Calories" /><button type="button" class="remove-row inline-flex h-10 w-10 items-center justify-center rounded-full border border-hairline text-body hover:text-ink">×</button>`;
      $("ingredients").appendChild(row);
      row.querySelector(".remove-row")?.addEventListener("click", () => { row.remove(); render(); });
    }

    function readIngredients() {
      const rows = document.querySelectorAll("#ingredients > div");
      const out: { name: string; calories: number }[] = [];
      rows.forEach((row) => {
        const name = (row.querySelector(".ing-name") as HTMLInputElement).value.trim() ||"Ingredient";
        const cal = parseFloat((row.querySelector(".ing-cal") as HTMLInputElement).value) || 0;
        if (cal > 0) out.push({ name, calories: cal });
      });
      return out;
    }

    function render() {
      clearDirty();
      const servings = parseFloat(($("servings") as HTMLInputElement).value) || 1;
      ingredients = readIngredients();
      const total = ingredients.reduce((s, i) => s + i.calories, 0);
      const perServing = servings > 0 ? Math.round(total / servings) : total;
      $("recipe-total").textContent = total.toLocaleString("en-US");
      $("recipe-per").textContent = perServing.toLocaleString("en-US");
      $("recipe-table").innerHTML = ingredients.map((i) => `<tr class="border-b border-hairline last:border-0"><td class="px-5 py-2.5 text-body">${i.name}</td><td class="px-5 py-2.5 text-right text-mute tabular-nums">${i.calories.toLocaleString("en-US")}</td></tr>`).join("");
    }

    $("add-ingredient")?.addEventListener("click", () => addRow());
    $("calculate-btn")?.addEventListener("click", render);
    const form = $("calc-form") as HTMLFormElement;
    form.addEventListener("input", markDirty);
    form.addEventListener("submit", (e) => { e.preventDefault(); render(); });
    addRow("Chicken breast","165");
    addRow("Rice (cooked)","130");
    addRow("Broccoli","55");
  }
</script>


