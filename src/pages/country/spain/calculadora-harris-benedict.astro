const faqs: FaqItem[] = [
  { 
    q: "¿Qué es la fórmula de Harris-Benedict?", 
    a: "Es una ecuación matemática creada a principios del siglo XX que se utiliza para estimar la Tasa Metabólica Basal (TMB), es decir, la energía que el cuerpo necesita en reposo." 
  },
  { 
    q: "¿Para qué sirve Harris-Benedict?", 
    a: "Sirve como punto de partida para estimar las calorías mínimas que una persona necesita para sobrevivir, lo cual es útil para calcular posteriormente el gasto energético total diario." 
  },
  { 
    q: "¿Cómo se calcula la TMB con Harris-Benedict?", 
    a: "Se utilizan fórmulas diferentes para hombres y mujeres, las cuales multiplican el peso, la altura y la edad por coeficientes específicos y luego suman los resultados." 
  },
  { 
    q: "¿Cuál es la diferencia entre Harris-Benedict y Mifflin-St Jeor?", 
    a: "Ambas estiman el gasto energético en reposo usando edad, sexo, peso y altura, pero emplean coeficientes matemáticos distintos. Mifflin-St Jeor fue desarrollada más recientemente." 
  },
  { 
    q: "¿Harris-Benedict calcula las calorías diarias?", 
    a: "No de forma directa. La fórmula solo calcula la Tasa Metabólica Basal. Para obtener las calorías diarias totales (GET), el resultado debe multiplicarse por un factor de actividad física." 
  },
  { 
    q: "¿La fórmula de Harris-Benedict es exacta?", 
    a: "No, ninguna fórmula matemática proporciona un resultado 100 % exacto para todos los individuos. Solo ofrece una estimación aproximada que puede variar según la composición corporal de cada persona." 
  },
  {
    q: "¿Qué fórmula utiliza la calculadora de CalorieCalculatorFree?",
