const faqs: FaqItem[] = [
  { 
    q:"¿Cuántas calorías debo consumir al día para mantener mi peso?", 
    a:"Depende de tus características personales y tu nivel de actividad física. Si calculas tu GET (Gasto Energético Total), la cifra resultante es tu nivel de mantenimiento. Consumir esa cantidad hará que tu peso se mantenga relativamente estable." 
  },
  { 
    q:"¿Cuántas calorías debo consumir para perder peso?", 
    a:"Para perder peso, generalmente se necesita crear un déficit calórico consumiendo menos energía de la que gastas. Muchos profesionales sugieren una reducción moderada (por ejemplo, 300 a 500 calorías menos de tu mantenimiento), pero es mejor adaptar esto a tus circunstancias personales." 
  },
  { 
    q:"¿Las calorías que necesito dependen de mi edad?", 
    a:"Sí. A medida que envejecemos, la masa muscular tiende a disminuir y el metabolismo basal se ralentiza ligeramente, lo que significa que generalmente se necesitan menos calorías diarias en comparación con la juventud, asumiendo que el nivel de actividad sea el mismo." 
  },
  { 
    q:"¿Cómo se calculan las calorías diarias?", 
    a:"Se estiman calculando primero la Tasa Metabólica Basal (TMB), que son las calorías que quemas en reposo. Luego, la TMB se multiplica por un factor de actividad física para obtener el Gasto Energético Total (GET)." 
  },
  { 
    q:"¿Qué diferencia hay entre TMB y TDEE?", 
    a:"La TMB (Tasa Metabólica Basal) es la energía necesaria solo para mantener las funciones vitales en reposo absoluto. El TDEE (o GET, Gasto Energético Total) incluye la TMB más todas las calorías quemadas mediante el movimiento diario, el ejercicio y la digestión de alimentos." 
  },
  { 
    q:"¿Puedo usar una calculadora de calorías para ganar peso?", 
    a:"Sí. Si tu objetivo es aumentar masa muscular o subir de peso, puedes usar la calculadora para estimar tu gasto total y luego añadir un excedente moderado a esa cantidad para favorecer el aumento de peso de forma controlada." 
  }
];

const seoTitle ="¿Cuántas Calorías Debo Consumir al Día? Guía Completa y Científica";
const seoDescription ="Descubre con exactitud cuántas calorías necesitas al día según tu edad, peso, altura y nivel de actividad. Aprende a calcular tus necesidades calóricas reales para mantener, perder o ganar peso de forma saludable y respaldada por la ciencia.";
---

<ContentLayout
  title={seoTitle}
