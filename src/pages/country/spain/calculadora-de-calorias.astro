---
import Layout from '../../../layouts/Layout.astro';
import Section from '../../../components/ui/Section.astro';
import CalculadoraCalorias from '../../../components/calculators/CalculadoraCalorias.astro';
import FaqSection from '../../../components/FaqSection.astro';
import { faqSchema, softwareApplicationSchema } from "../../../lib/seo";

const faqs = [
  {
    q: "¿Cuántas calorías debo consumir al día para bajar de peso?",
    a: "Para perder peso de forma segura y sostenible, debes consumir entre 300 y 500 calorías por debajo de tu Gasto Energético Total (GET / TDEE). Esto genera un déficit calórico moderado que produce una pérdida de grasa de 0,3 a 0,5 kg por semana sin provocar pérdida de masa muscular ni ralentización metabólica."
  },
  {
    q: "¿Cómo se calcula el déficit calórico manualmente?",
    a: "1) Calcula tu Tasa Metabólica Basal (TMB) con la fórmula de Mifflin-St Jeor. 2) Multiplica tu TMB por tu factor de actividad física (1.2 a 1.9) para obtener tu GET de mantenimiento. 3) Resta un 15% a 20% (o entre 300 y 500 kcal). El resultado son tus calorías diarias objetivo."
  },
  {
    q: "¿Cuál es el límite mínimo seguro de calorías para mujeres y hombres?",
    a: "Como regla médica general, las mujeres nunca deben consumir menos de 1.200 calorías al día y los hombres nunca menos de 1.500 calorías al día sin supervisión clínica. Caer por debajo de estos umbrales compromete la función tiroidea, altera el equilibrio hormonal y acelera el catabolismo muscular."
  },
  {
    q: "¿Por qué me he estancado en la pérdida de peso si sigo en déficit?",
    a: "El estancamiento suele deberse a la adaptación metabólica (a medida que pierdes peso, tu cuerpo requiere menos energía), una disminución inconsciente del NEAT (actividad espontánea fuera del ejercicio), o pequeñas imprecisiones en el pesaje de alimentos (aceites, salsas y picoteos no contabilizados)."
  },
  {
    q: "¿Qué fórmula utiliza esta calculadora de calorías?",
    a: "Utilizamos la ecuación validada de Mifflin-St Jeor (1990), reconocida internacionalmente por la Academia de Nutrición y Dietética como la fórmula de mayor precisión clínica para la población moderna."
  },
  {
    q: "¿Cuál es la diferencia entre TMB (Tasa Metabólica Basal) y GET (Gasto Energético Total)?",
    a: "La TMB representa las calorías que tu cuerpo quema en reposo absoluto solo para mantenerte vivo (respiración, corazón, cerebro). El GET (o TDEE) es la TMB más todas las calorías que quemas trabajando, caminando, haciendo la digestión y entrenando."
  },
  {
    q: "¿Debo contar las calorías que quemo con el ejercicio y 'comerlas de vuelta'?",
    a: "No se recomienda comer de vuelta todas las calorías reportadas por relojes o pulseras de actividad, ya que suelen sobreestimar el gasto real en un 25% a 50%. Si tu objetivo es perder peso, mantén tus calorías diarias fijas según tu nivel de actividad semanal promedio."
  }
];

const jsonLd = [
  softwareApplicationSchema(
    "Calculadora de Déficit Calórico y Calorías Diarias",
    "Calculadora gratuita en español para estimar necesidades calóricas diarias, déficit calórico para perder peso, Tasa Metabólica Basal (TMB) y Gasto Energético Total (GET).",
    "/country/spain/calculadora-de-calorias/"
  ),
  faqSchema(faqs)
];

const hreflangs = [
  { href: "https://caloriecalculatorfree.com/", hreflang: "en" },
  { href: "https://caloriecalculatorfree.com/country/spain/calculadora-de-calorias/", hreflang: "es" },
  { href: "https://caloriecalculatorfree.com/country/spain/calculadora-de-calorias/", hreflang: "es-ES" }
];
---

<Layout
  title="Calculadora de Déficit Calórico y Calorías Diarias (TMB y GET)"
  exactTitle={true}
  description="Calculadora de déficit calórico y calorías diarias gratis. Calcula tu TMB, TDEE y macronutrientes exactos para perder peso, quemar grasa o ganar masa muscular."
  lang="es"
  hreflangs={hreflangs}
  jsonLd={jsonLd}
>
  <header class="relative overflow-hidden pt-12 pb-12 text-center">
    <div class="bg-grid pointer-events-none absolute inset-0 -z-10 opacity-50" aria-hidden="true"></div>
    <div class="container-page">
      <h1 class="text-display-lg text-ink font-bold tracking-tight">Calculadora de Déficit Calórico y Calorías Diarias</h1>
      <p class="mt-4 mx-auto max-w-2xl text-lg text-body">
        Calcula con precisión científica cuántas calorías debes consumir al día para perder grasa, mantener tu peso o ganar masa muscular. Descubre tu <a href="/country/spain/que-es-el-metabolismo-basal/" class="text-brand hover:underline font-medium">Tasa Metabólica Basal</a> (TMB), tu Gasto Energético Total (GET) y tu déficit calórico ideal.
      </p>
    </div>
  </header>

  <Section class="pb-16 pt-0">
    <div class="container-page max-w-5xl">
      <CalculadoraCalorias />
    </div>
  </Section>

  <Section class="bg-canvas-soft border-t border-hairline py-16">
    <div class="prose-content mx-auto max-w-3xl space-y-12">

      <!-- Featured Snippet Answer Box: ¿Cuántas calorías consumir para bajar de peso? -->
      <div class="not-prose p-6 md:p-8 bg-surface border-l-4 border-brand rounded-r-2xl shadow-sm">
        <h2 class="text-2xl font-bold text-ink mb-3">¿Cuántas calorías debo consumir al día para bajar de peso?</h2>
        <p class="text-body text-base md:text-lg leading-relaxed mb-4">
          Para perder grasa corporal de forma constante y saludable, debes consumir entre <strong>300 y 500 calorías por debajo</strong> de tu Gasto Energético Total (GET de mantenimiento). Para la mayoría de las mujeres adultas, esto equivale a un rango de <strong>1.400 a 1.700 kcal/día</strong>; para la mayoría de los hombres adultos, se sitúa entre <strong>1.800 y 2.200 kcal/día</strong>, dependiendo del peso actual y del nivel de actividad física.
        </p>
        <div class="grid sm:grid-cols-3 gap-3 text-center text-xs font-semibold pt-2">
          <div class="p-3 bg-canvas-soft rounded-xl border border-hairline">
            <span class="block text-brand text-sm font-bold">Déficit Suave (-250 kcal)</span>
            <span class="text-mute">Pérdida de ~0,25 kg/semana</span>
          </div>
          <div class="p-3 bg-canvas-soft rounded-xl border border-hairline">
            <span class="block text-brand text-sm font-bold">Déficit Moderado (-500 kcal)</span>
            <span class="text-mute">Pérdida de ~0,50 kg/semana</span>
          </div>
          <div class="p-3 bg-canvas-soft rounded-xl border border-hairline">
            <span class="block text-brand text-sm font-bold">Déficit Máximo (-750 kcal)</span>
            <span class="text-mute">Pérdida de ~0,75 kg/semana</span>
          </div>
        </div>
      </div>

      <!-- Section: Cómo calcular tu déficit paso a paso -->
      <div>
        <h2 class="text-display-md text-ink mb-6">Calculadora de déficit calórico: Cómo calcular tu objetivo paso a paso</h2>
        <p class="text-body text-base md:text-lg leading-relaxed mb-4">
          Un déficit calórico se produce cuando ingieres menos energía a través de los alimentos de la que tu cuerpo gasta para mantenerse vivo y moverse. Nuestro algoritmo automatiza este cálculo en tres fases respaldadas por la fisiología médica:
        </p>
        <ul class="space-y-4 text-base text-body">
          <li class="flex items-start">
            <span class="flex-shrink-0 w-7 h-7 rounded-full bg-brand-soft text-brand flex items-center justify-center font-bold mr-3 mt-0.5">1</span>
            <div>
              <strong class="text-ink">Paso 1: Cálculo de la Tasa Metabólica Basal (TMB).</strong>
              <p class="mt-1">Calculamos tu gasto vital en reposo mediante la fórmula clínica de Mifflin-St Jeor, que considera tu sexo biológico, edad, peso y estatura.</p>
            </div>
          </li>
          <li class="flex items-start">
            <span class="flex-shrink-0 w-7 h-7 rounded-full bg-brand-soft text-brand flex items-center justify-center font-bold mr-3 mt-0.5">2</span>
            <div>
              <strong class="text-ink">Paso 2: Ajuste por Actividad Física (GET / TDEE).</strong>
              <p class="mt-1">Multiplicamos la TMB por tu factor de estilo de vida, sumando el <a href="/country/spain/que-es-el-neat/" class="text-brand font-medium hover:underline">NEAT (actividad espontánea)</a> y el <a href="/country/spain/efecto-termico-de-los-alimentos/" class="text-brand font-medium hover:underline">efecto térmico de los alimentos</a>.</p>
            </div>
          </li>
          <li class="flex items-start">
            <span class="flex-shrink-0 w-7 h-7 rounded-full bg-brand-soft text-brand flex items-center justify-center font-bold mr-3 mt-0.5">3</span>
            <div>
              <strong class="text-ink">Paso 3: Aplicación del Déficit o Superávit Estratégico.</strong>
              <p class="mt-1">Si buscas perder grasa, restamos entre 300 y 500 kcal. Si tu meta es hipertrofia muscular magra, sumamos un <a href="/country/spain/que-es-el-superavit-calorico/" class="text-brand font-medium hover:underline">superávit calórico controlado</a> de 250 a 400 kcal.</p>
            </div>
          </li>
        </ul>
      </div>

      <!-- Section: Tabla de Calorías Recomendadas según Peso -->
      <div>
        <h2 class="text-display-sm text-ink mb-4">Tabla de calorías diarias recomendadas para perder peso (según peso corporal)</h2>
        <p class="text-body text-base mb-6">
          La siguiente tabla orientativa muestra las necesidades calóricas de mantenimiento frente a un déficit estándar de 500 kcal para personas con actividad física moderada (entrenamiento 3-4 días por semana):
        </p>
        <div class="overflow-x-auto not-prose my-6">
          <table class="w-full text-left text-sm border-collapse border border-hairline rounded-xl overflow-hidden shadow-sm">
            <thead>
              <tr class="bg-canvas-soft border-b border-hairline text-ink">
                <th class="p-3.5 font-bold">Peso Corporal</th>
                <th class="p-3.5 font-bold">Mantenimiento Mujer (GET)</th>
                <th class="p-3.5 font-bold">Déficit Mujer (-500 kcal)</th>
                <th class="p-3.5 font-bold">Mantenimiento Hombre (GET)</th>
                <th class="p-3.5 font-bold">Déficit Hombre (-500 kcal)</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-hairline bg-surface text-body">
              <tr>
                <td class="p-3.5 font-semibold text-ink">55 kg</td>
                <td class="p-3.5">~1.750 kcal</td>
                <td class="p-3.5 font-bold text-brand">~1.250 kcal</td>
                <td class="p-3.5">~2.050 kcal</td>
                <td class="p-3.5 font-bold text-brand">~1.550 kcal</td>
              </tr>
              <tr>
                <td class="p-3.5 font-semibold text-ink">65 kg</td>
                <td class="p-3.5">~1.900 kcal</td>
                <td class="p-3.5 font-bold text-brand">~1.400 kcal</td>
                <td class="p-3.5">~2.250 kcal</td>
                <td class="p-3.5 font-bold text-brand">~1.750 kcal</td>
              </tr>
              <tr>
                <td class="p-3.5 font-semibold text-ink">75 kg</td>
                <td class="p-3.5">~2.050 kcal</td>
                <td class="p-3.5 font-bold text-brand">~1.550 kcal</td>
                <td class="p-3.5">~2.450 kcal</td>
                <td class="p-3.5 font-bold text-brand">~1.950 kcal</td>
              </tr>
              <tr>
                <td class="p-3.5 font-semibold text-ink">85 kg</td>
                <td class="p-3.5">~2.200 kcal</td>
                <td class="p-3.5 font-bold text-brand">~1.700 kcal</td>
                <td class="p-3.5">~2.650 kcal</td>
                <td class="p-3.5 font-bold text-brand">~2.150 kcal</td>
              </tr>
              <tr>
                <td class="p-3.5 font-semibold text-ink">95 kg</td>
                <td class="p-3.5">~2.350 kcal</td>
                <td class="p-3.5 font-bold text-brand">~1.850 kcal</td>
                <td class="p-3.5">~2.850 kcal</td>
                <td class="p-3.5 font-bold text-brand">~2.350 kcal</td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>

      <!-- Section: Límites de Seguridad Metabólica -->
      <div class="p-6 md:p-8 bg-surface rounded-2xl border border-hairline">
        <h2 class="text-2xl font-bold text-ink mb-4">Déficit calórico para mujeres vs. hombres: Umbrales mínimos de seguridad</h2>
        <p class="text-body text-base leading-relaxed mb-4">
          Una creencia errónea muy extendida es pensar que cuanto menos comas, más rápido y mejor adelgazarás. En la práctica clínica deportiva, recortar calorías de forma excesiva desencadena la denominada <strong>adaptación metabólica severa</strong>.
        </p>
        <div class="grid sm:grid-cols-2 gap-4 not-prose my-6">
          <div class="p-5 bg-canvas-soft rounded-xl border border-hairline">
            <h3 class="text-base font-bold text-ink mb-2">Umbral Mínimo para Mujeres: 1.200 kcal</h3>
            <p class="text-xs text-body leading-relaxed">
              Consumir menos de 1.200 calorías al día en mujeres eleva el riesgo de hipotiroidismo funcional, caída de estrógenos, alteración del ciclo menstrual (amenorrea) y pérdida acelerada de masa muscular.
            </p>
          </div>
          <div class="p-5 bg-canvas-soft rounded-xl border border-hairline">
            <h3 class="text-base font-bold text-ink mb-2">Umbral Mínimo para Hombres: 1.500 kcal</h3>
            <p class="text-xs text-body leading-relaxed">
              En hombres, un déficit agresivo por debajo de 1.500 calorías colapsa los niveles de testosterona libre, provoca letargo diurno y desencadena una pérdida severa de fuerza y masa magra.
            </p>
          </div>
        </div>
        <p class="text-body text-base">
          Para acompañar tu déficit y garantizar que el peso perdido proceda de la grasa y no del músculo, es fundamental acompañar tus calorías con un reparto adecuado de proteínas utilizando nuestra <a href="/country/spain/calculadora-de-macros/" class="text-brand font-semibold hover:underline">Calculadora de Macros</a>.
        </p>
      </div>

      <!-- Section: Guías relacionadas del clúster en español -->
      <div class="not-prose pt-8 border-t border-hairline">
        <h2 class="text-2xl font-bold text-ink mb-6 text-center">Guías Científicas de Nutrición y Metabolismo</h2>
        <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          <a href="/country/spain/calculadora-de-macros/" class="p-5 bg-surface hover:bg-canvas-soft border border-hairline rounded-2xl transition-all hover:shadow-md group">
            <span class="block text-xs font-semibold text-brand uppercase tracking-wider mb-1">Nutrición y Reparto</span>
            <strong class="block text-ink text-base group-hover:text-brand transition-colors">Calculadora de Macros</strong>
            <p class="text-mute text-xs mt-2">Aprende a repartir tus proteínas, grasas y carbohidratos según tu meta.</p>
          </a>
          <a href="/country/spain/que-es-el-metabolismo-basal/" class="p-5 bg-surface hover:bg-canvas-soft border border-hairline rounded-2xl transition-all hover:shadow-md group">
            <span class="block text-xs font-semibold text-brand uppercase tracking-wider mb-1">Gasto en Reposo</span>
            <strong class="block text-ink text-base group-hover:text-brand transition-colors">Tasa Metabólica Basal (TMB)</strong>
            <p class="text-mute text-xs mt-2">Cómo calcula tu cuerpo la energía vital con Mifflin-St Jeor.</p>
          </a>
          <a href="/country/spain/que-es-el-superavit-calorico/" class="p-5 bg-surface hover:bg-canvas-soft border border-hairline rounded-2xl transition-all hover:shadow-md group">
            <span class="block text-xs font-semibold text-brand uppercase tracking-wider mb-1">Ganancia Muscular</span>
            <strong class="block text-ink text-base group-hover:text-brand transition-colors">Superávit Calórico y Volumen</strong>
            <p class="text-mute text-xs mt-2">Cómo ganar masa muscular limpia sin acumular grasa excesiva.</p>
          </a>
        </div>
      </div>

    </div>
  </Section>

  <Section class="border-t border-hairline bg-canvas-soft py-16">
    <div class="container-page max-w-5xl">
      <FaqSection hideSidebar={true} items={faqs} title="Preguntas Frecuentes sobre Calorías y Déficit Calórico" />
    </div>
  </Section>
</Layout>
