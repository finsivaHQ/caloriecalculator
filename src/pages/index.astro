---
import Layout from "../layouts/Layout.astro";
import Section from "../components/ui/Section.astro";
import Button from "../components/ui/Button.astro";
import CalorieCalculator from "../components/calculators/CalorieCalculator.astro";
import FaqSection from "../components/FaqSection.astro";
import Sources from "../components/ui/Sources.astro";
import { HOME_FAQS } from "../data/faqs";
import {
  organizationSchema,
  websiteSchema,
  faqSchema,
  calculatorSchema,
} from "../lib/seo";

const trust = [
  { label: "Science-backed formulas", icon: "M9 12l2 2 4-4", description: "Uses the Mifflin-St Jeor BMR equation." },
  { label: "Private by design", icon: "M13 2L3 14h9l-1 8 10-12h-9z", description: "Calculations run securely in your browser." },
  { label: "Free & fast", icon: "M20 6L9 17l-5-5", description: "No sign-up, no paywall, completely free." },
];

const jsonLd = [
  organizationSchema(),
  websiteSchema(),
  calculatorSchema(
    "Calorie Calculator",
    "Free calorie calculator to find your estimated daily calorie needs for weight loss, gain, or maintenance.",
    "/"
  ),
  faqSchema(HOME_FAQS),
];
---

<Layout
  title="Free Calorie Calculator: TDEE, Macros & Weight Loss"
  exactTitle={true}
  description="Estimate your daily calorie needs for weight loss, maintenance, or muscle gain. Get your TDEE, BMR, and personalized macro targets instantly."
  jsonLd={jsonLd}
  hreflangs={[
    { href: "https://caloriecalculatorfree.com/", hreflang: "en" },
    { href: "https://caloriecalculatorfree.com/country/spain/calculadora-de-calorias/", hreflang: "es" },
    { href: "https://caloriecalculatorfree.com/country/spain/calculadora-de-calorias/", hreflang: "es-ES" }
  ]}
>
  <!-- 📈 Calculator (Top) -->
  <section class="pt-12 pb-16 sm:pt-16 sm:pb-24">
    <div class="px-4 sm:px-6 lg:px-8">
      <div class="mx-auto max-w-3xl text-center mb-10">
        <h1 class="text-display-xl text-ink">
          Calorie Calculator
        </h1>
        <p class="mx-auto mt-4 max-w-xl text-lg text-body">
          Calculate your daily energy needs. Uses the Mifflin-St Jeor equation.
        </p>
      </div>
      
      <div id="calculator" class="mx-auto max-w-5xl scroll-mt-20">
        <CalorieCalculator />
      </div>
    </div>
  </section>

  <!-- 🛡️ Key Points (Trust) -->
  <Section class="border-t border-hairline bg-canvas-soft">
    <div class="grid gap-8 sm:grid-cols-3 max-w-5xl mx-auto">
      {trust.map((t) => (
        <div class="flex flex-col items-center text-center">
          <div class="mb-3 text-brand">
            <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d={t.icon} />
            </svg>
          </div>
          <h3 class="text-sm font-semibold text-ink">{t.label}</h3>
          <p class="mt-1 text-sm text-mute max-w-xs">{t.description}</p>
        </div>
      ))}
    </div>
  </Section>

  <!-- 📚 Educational / SEO content -->
  <Section class="border-t border-hairline">
    <div class="prose-content mx-auto max-w-3xl">

      <h2>How the Calorie Calculator Works</h2>
      <p>
        This calculator acts as a starting point to help you understand your body's energy needs. By entering your age, gender, height, weight, and activity level, the tool estimates the total number of calories your body burns in a single day.
      </p>
      <p>
        Once the baseline is calculated, you can select your goal (such as weight loss, maintenance, or weight gain). The calculator then adjusts your daily calorie target and provides a suggested macronutrient split (protein, carbohydrates, and fats) to help you plan your meals effectively.
      </p>

      <h2>How We Calculate Your Daily Calories</h2>
      <p>
        To provide a reliable estimate, our calculator uses a standard, two-step mathematical process widely used by dietitians and health professionals. 
      </p>
      
      <h3>Basal Metabolic Rate (BMR)</h3>
      <p>
        Your BMR is the amount of energy your body requires simply to stay alive at rest—powering your brain, breathing, and keeping your heart beating. We use the <strong>Mifflin-St Jeor equation</strong> to estimate this, which research has shown to be highly reliable for the general population.
      </p>

      <h3>Total Daily Energy Expenditure (TDEE)</h3>
      <p>
        You burn more calories than your BMR because you move around during the day. TDEE takes your BMR and multiplies it by an <strong>Activity Level Multiplier</strong>. This final TDEE number represents the estimated total calories you burn in a typical 24-hour period.
      </p>

      <h3>Activity Levels Explained</h3>
      <ul>
        <li><strong>Sedentary (x1.2):</strong> Little to no exercise, desk job.</li>
        <li><strong>Lightly Active (x1.375):</strong> Light exercise 1–3 days a week.</li>
        <li><strong>Moderately Active (x1.55):</strong> Moderate exercise 3–5 days a week.</li>
        <li><strong>Very Active (x1.725):</strong> Hard exercise 6–7 days a week.</li>
        <li><strong>Extra Active (x1.9):</strong> Very hard exercise, physical job, or training twice a day.</li>
      </ul>

      <h2>Calories for Weight Loss</h2>
      <p>
        If your goal is to lose weight, you must consume fewer calories than your TDEE. This is called a <strong>calorie deficit</strong>. A widely accepted guideline is that a deficit of roughly 500 calories per day leads to an estimated 1 pound of weight loss per week.
      </p>
      <p>
        The calculator provides options for mild weight loss (0.5 lbs/week), standard weight loss (1 lb/week), and extreme weight loss (2 lbs/week). Keep in mind that extreme deficits can be difficult to sustain and may cause muscle loss, so moderate, steady targets are generally recommended.
      </p>

      <h2>Calories for Weight Gain</h2>
      <p>
        To gain weight—or build muscle—you need to consume more calories than you burn. This is called a <strong>calorie surplus</strong>. Adding 250 to 500 calories above your TDEE provides your body with the extra energy needed to fuel workouts and synthesize new muscle tissue.
      </p>

      <h2>Maintenance Calories</h2>
      <p>
        Maintenance calories are simply your TDEE. If you eat this exact amount of calories over a sustained period, your weight should remain relatively stable. This is a great target for those who are happy with their current weight and want to focus on body recomposition or athletic performance.
      </p>

      <h2>Example Calculation</h2>
      <p>
        Let's look at an example for a 30-year-old male who is 180 cm (5'11") tall, weighs 80 kg (176 lbs), and works a desk job (Sedentary).
      </p>
      <ul>
        <li><strong>BMR Calculation:</strong> Using the Mifflin-St Jeor equation, his body burns roughly <strong>1,816 calories</strong> at rest.</li>
        <li><strong>TDEE Calculation:</strong> Because he is sedentary, we multiply 1,816 by 1.2, resulting in a TDEE of roughly <strong>2,179 calories</strong>.</li>
        <li><strong>Weight Loss Target:</strong> If he wants to lose 1 pound per week, he subtracts 500 calories, giving him a daily target of <strong>1,679 calories</strong>.</li>
      </ul>

      <h2>How Accurate Is a Calorie Calculator?</h2>
      <p>
        It is important to understand that <strong>all calorie calculators provide estimates, not exact measurements</strong>. Formulas like Mifflin-St Jeor are based on population averages. Your true individual metabolism can be influenced by genetics, body composition (muscle mass burns more calories than fat), hormonal fluctuations, and neat (non-exercise activity thermogenesis). 
      </p>
      <p>
        The best approach is to use the calculator's result as your starting point. Eat at that target for two to three weeks, monitor how your body weight changes, and adjust your calories up or down based on your real-world progress.
      </p>

      <h2>Important Limitations & Safety</h2>
      <p>
        While calorie tracking is a useful tool, it is not appropriate for everyone. 
      </p>
      <ul>
        <li><strong>Minimum Intake:</strong> As a general clinical guideline (e.g., supported by Harvard Health), women are often advised not to drop below 1,200 calories per day, and men 1,500 calories per day, unless supervised by a medical professional.</li>
        <li><strong>Medical Conditions:</strong> Those with metabolic disorders, thyroid conditions, or other health issues should consult a doctor, as standard formulas may not apply.</li>
        <li><strong>Eating Disorders:</strong> If you have a history of disordered eating, calorie counting may be harmful. Please consult a qualified mental health or medical professional.</li>
      </ul>

      <Sources sources={[
        { label: "Dietary Guidelines for Americans — Calorie Needs", href: "https://www.dietaryguidelines.gov/" },
        { label: "Mifflin-St Jeor equation for resting energy expenditure — NIH", href: "https://pubmed.ncbi.nlm.nih.gov/2305711/" },
      ]} />

    </div>
  </Section>

  <!-- ❓ FAQ -->
  <Section class="border-t border-hairline bg-canvas-soft">
    <FaqSection items={HOME_FAQS} />
  </Section>

</Layout>
