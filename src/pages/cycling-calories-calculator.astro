import type { FaqItem } from"../lib/seo";
import ArticleImage from"../components/ui/ArticleImage.astro";
import Sources from"../components/ui/Sources.astro";

const faqs: FaqItem[] = [
  { q:"How many calories does cycling burn?", a:"Cycling burns roughly 4–15.8 kcal per minute depending on intensity. A 70 kg person biking at a moderate 12 mph burns about 360 calories per hour." },
  { q:"How many calories does cycling 10 km burn?", a:"A 70 kg rider burns roughly 150–250 calories cycling 10 km at moderate pace, depending on wind, terrain, and speed." },
  { q:"Is cycling good for weight loss?", a:"Yes. Cycling is low-impact, easy on the joints, and can burn 400–800+ calories per hour. Consistent weekly sessions combined with a sensible diet produce solid fat loss." },
  { q:"How many calories does mountain biking burn?", a:"Mountain biking typically burns 500–900 calories per hour due to varied terrain, climbs, and technical effort — often more than flat-road cycling." },
  { q:"How often should I cycle to lose weight?", a:"3–5 cycling sessions per week lasting 30–60 minutes each is a sustainable starting point, combined with a modest calorie deficit." },
  { q:"Is cycling better than running for calories?", a:"Running usually burns more calories per minute, but cycling is gentler on the joints and easier to sustain for longer durations. Both are excellent for calorie burn." },
  { q:"How do I cycle for maximum calorie burn?", a:"Ride at a higher intensity, add hills or resistance, try interval bursts, and extend your ride duration. Standing climbs and sprint intervals raise the burn." },
  { q:"What is the best cycling intensity for fat loss?", a:"A mix of steady endurance rides and short high-intensity intervals works well. Include longer moderate rides plus occasional hill or sprint sessions." },
  { q:"What are MET values for cycling?", a:"MET measures exercise intensity. Leisure cycling is around 4.0 MET, moderate pace is 6.0 MET, vigorous is 8.0 MET, and racing can reach 15.8 MET. Higher MET means more calories burned per minute." },
  { q:"How does cycling speed affect calorie burn?", a:"Faster speeds increase resistance and effort, raising MET values. Going from 10 mph to 20 mph can double or triple calories burned per minute for the same rider weight." },
  { q:"Does indoor cycling burn the same calories as outdoor?", a:"Indoor cycling is usually slightly lower because there's no wind resistance or terrain variation. However, a stationary bike with resistance can match outdoor calorie burn at higher intensities." },
  { q:"Can I burn 1000 calories cycling?", a:"Yes, a 70 kg rider can burn 1000+ calories during a vigorous 90-minute ride or a long mountain bike session. Consistency matters more than single extreme sessions." },
];
